module.exports = "{\n    \"2000001\": {\n        \"id\": 2000001,\n        \"name\": \"阿尔图\",\n        \"title\": \"被选中的人\",\n        \"text\": \"你自己，一个卷入苏丹游戏的可悲之人。\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"char\",\n        \"tips\": \"\",\n        \"rare\": 3,\n        \"resource\": \"cards/2000001\",\n        \"tag\": {\n            \"体魄\": 3,\n            \"魅力\": 2,\n            \"智慧\": 1,\n            \"男性\": 1,\n            \"贵族\": 1,\n            \"主角\": 1,\n            \"战斗\": 2,\n            \"社交\": 1,\n            \"已拥有\": 1,\n            \"支持\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {\n            \"over\": 13\n        },\n        \"equips\": [\n            \"武器\",\n            \"服装\",\n            \"饰品\"\n        ],\n        \"is_only\": 1\n    },\n    \"2000002\": {\n        \"id\": 2000002,\n        \"name\": \"阿尔图\",\n        \"title\": \"被选中的人\",\n        \"text\": \"你自己，一个卷入苏丹游戏的可悲之人。\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"char\",\n        \"tips\": \"\",\n        \"rare\": 3,\n        \"resource\": \"cards/2000002\",\n        \"tag\": {\n            \"体魄\": 1,\n            \"魅力\": 3,\n            \"智慧\": 2,\n            \"男性\": 1,\n            \"贵族\": 1,\n            \"主角\": 1,\n            \"社交\": 2,\n            \"隐匿\": 1,\n            \"已拥有\": 1,\n            \"支持\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {\n            \"over\": 13\n        },\n        \"equips\": [\n            \"武器\",\n            \"服装\",\n            \"饰品\"\n        ],\n        \"is_only\": 1\n    },\n    \"2000003\": {\n        \"id\": 2000003,\n        \"name\": \"阿尔图\",\n        \"title\": \"被选中的人\",\n        \"text\": \"你自己，一个卷入苏丹游戏的可悲之人。\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"char\",\n        \"tips\": \"\",\n        \"rare\": 3,\n        \"resource\": \"cards/2000003\",\n        \"tag\": {\n            \"体魄\": 1,\n            \"魅力\": 2,\n            \"智慧\": 3,\n            \"男性\": 1,\n            \"贵族\": 1,\n            \"主角\": 1,\n            \"魔力\": 1,\n            \"已拥有\": 1,\n            \"支持\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {\n            \"over\": 13\n        },\n        \"equips\": [\n            \"武器\",\n            \"服装\",\n            \"饰品\"\n        ],\n        \"is_only\": 1\n    },\n    \"2000005\": {\n        \"id\": 2000005,\n        \"name\": \"巴拉特\",\n        \"title\": \"异国商人\",\n        \"text\": \"售卖各类异国风物的商人，目前租住在你名下的商铺里。据说来到这座城市之前曾越过沙漠游历诸国，知晓很多神秘古老的故事，很受孩子们的欢迎。然而，当人们问及他的故乡，他却常说，自己是一个没有家的人。\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"char\",\n        \"tips\": \"\",\n        \"rare\": 2,\n        \"resource\": \"cards/2000005\",\n        \"tag\": {\n            \"体魄\": 1,\n            \"魅力\": 2,\n            \"智慧\": 2,\n            \"男性\": 1,\n            \"社交\": 2,\n            \"异国商人\": 1,\n            \"纯色材质\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [\n            \"武器\",\n            \"服装\",\n            \"饰品\"\n        ],\n        \"is_only\": 1\n    },\n    \"2000006\": {\n        \"id\": 2000006,\n        \"name\": \"梅姬\",\n        \"title\": \"你的妻子\",\n        \"text\": \"你的妻子，父母还在世时为年轻的你安排的婚姻。她是一个有智慧，值得尊敬的女人，可能没有多少激情，但你们的婚姻稳固而安宁。即使在你被卷入这场致命的游戏后，她也没有露出过哪怕一丝想要离开你的情绪，但偶尔还是能够听到她的叹息。\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"char\",\n        \"tips\": \"\",\n        \"rare\": 2,\n        \"resource\": \"cards/2000006\",\n        \"tag\": {\n            \"体魄\": 2,\n            \"魅力\": 2,\n            \"智慧\": 2,\n            \"女性\": 1,\n            \"贵族\": 1,\n            \"妻子\": 1,\n            \"命运的羁绊\": 1,\n            \"支持\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [\n            \"武器\",\n            \"服装\",\n            \"饰品\"\n        ],\n        \"is_only\": 1\n    },\n    \"2000008\": {\n        \"id\": 2000008,\n        \"name\": \"安苏亚\",\n        \"title\": \"亡国的公主\",\n        \"text\": \"某个部落曾因邻国的掠劫向苏丹祈求庇护，苏丹笑纳了他们的公主，并用铁蹄率先踏破了他们的王都。失去一切的安苏亚看透了苏丹的无常，对他再没有任何指望。苏丹也很快厌倦了、忘记了这位无聊的王妃，放任她如一株植物，悄无声息地在宫廷里慢慢枯萎，渐渐灭亡。\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"char\",\n        \"tips\": \"\",\n        \"rare\": 2,\n        \"resource\": \"cards/2000008\",\n        \"tag\": {\n            \"体魄\": 1,\n            \"魅力\": 5,\n            \"智慧\": 2,\n            \"女性\": 1,\n            \"社交\": 2\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [\n            \"武器\",\n            \"服装\",\n            \"饰品\"\n        ],\n        \"is_only\": 1\n    },\n    \"2000009\": {\n        \"id\": 2000009,\n        \"name\": \"萨达尔尼\",\n        \"title\": \"失宠的王妃\",\n        \"text\": \"曾因动人的美貌得到了苏丹盛极一时的恩宠，可惜世上永远有更年轻、更美貌的女人。萨达尔尼无法接受君王的移情别恋，用尽一切手段想要挽留那颗铁做成的心。恰恰好，她的疯狂正是苏丹乐于品尝的。\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"char\",\n        \"tips\": \"\",\n        \"rare\": 3,\n        \"resource\": \"cards/2000009\",\n        \"tag\": {\n            \"体魄\": 1,\n            \"魅力\": 7,\n            \"智慧\": 3,\n            \"女性\": 1,\n            \"社交\": 2,\n            \"纯色材质\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [\n            \"武器\",\n            \"服装\",\n            \"饰品\"\n        ],\n        \"is_only\": 1\n    },\n    \"2000010\": {\n        \"id\": 2000010,\n        \"name\": \"莎姬\",\n        \"title\": \"苏丹的宠妃\",\n        \"text\": \"君王的宠爱让人们一夜之间忘记了莎姬低贱的出身。她高傲地、盛气凌人地、无忧无虑地享受着一切讨好和追捧。反正她这年轻美艳的躯体已经得到了比在欢愉之馆多千万倍的回报，至于明天会怎么样，她不在乎。\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"char\",\n        \"tips\": \"\",\n        \"rare\": 4,\n        \"resource\": \"cards/2000010\",\n        \"tag\": {\n            \"体魄\": 1,\n            \"魅力\": 9,\n            \"智慧\": 1,\n            \"女性\": 1,\n            \"社交\": 2,\n            \"纯色材质\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [\n            \"武器\",\n            \"服装\",\n            \"饰品\"\n        ],\n        \"is_only\": 1\n    },\n    \"2000011\": {\n        \"id\": 2000011,\n        \"name\": \"萨米尔\",\n        \"title\": \"御医\",\n        \"text\": \"萨米尔服务宫廷已经超过十年。他艺术精湛、衣冠楚楚、不近女色，因为比起身强体壮的苏丹，他更多的得为柔弱的宫廷女眷们诊病。据说君王曾将一名男宠赐给他，他们至今依然感情和睦，相敬如宾。\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"char\",\n        \"tips\": \"\",\n        \"rare\": 3,\n        \"resource\": \"cards/2000011\",\n        \"tag\": {\n            \"体魄\": 2,\n            \"魅力\": 1,\n            \"智慧\": 4,\n            \"男性\": 1,\n            \"贵族\": 1,\n            \"爱书人\": 1,\n            \"反对\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [\n            \"武器\",\n            \"服装\",\n            \"饰品\"\n        ],\n        \"is_only\": 1\n    },\n    \"2000012\": {\n        \"id\": 2000012,\n        \"name\": \"赛里曼\",\n        \"title\": \"禁卫队长\",\n        \"text\": \"被苏丹赐予近卫的荣誉，可以携带武器站在他身边的四人之一。他负责苏丹宫廷与后宫的安全，是苏丹最信赖的人，也是王国最好的剑客之一。\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"char\",\n        \"tips\": \"\",\n        \"rare\": 3,\n        \"resource\": \"cards/2000012\",\n        \"tag\": {\n            \"体魄\": 8,\n            \"魅力\": 3,\n            \"智慧\": 2,\n            \"男性\": 1,\n            \"战斗\": 7,\n            \"隐匿\": 2,\n            \"生存\": 1,\n            \"将领\": 1,\n            \"苏丹的近卫\": 1,\n            \"反对\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [\n            \"武器\"\n        ],\n        \"is_only\": 1\n    },\n    \"2000013\": {\n        \"id\": 2000013,\n        \"name\": \"流浪剑客\",\n        \"title\": \"流浪剑客\",\n        \"text\": \"作为黑街公认的最厉害的佣兵和剑客，他拒绝告诉任何人自己的姓名。能认出他的除了那把金色的佩剑之外，还有他那副总是喝着酒、拥着女人，直到花光最后一枚金币的浪荡做派。\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"char\",\n        \"tips\": \"\",\n        \"rare\": 4,\n        \"resource\": \"cards/2000013\",\n        \"tag\": {\n            \"体魄\": 5,\n            \"魅力\": 4,\n            \"智慧\": 3,\n            \"男性\": 1,\n            \"战斗\": 5,\n            \"隐匿\": 3,\n            \"生存\": 3,\n            \"社交\": 1,\n            \"纯色材质\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [\n            \"武器\",\n            \"服装\",\n            \"饰品\"\n        ],\n        \"is_only\": 1\n    },\n    \"2000014\": {\n        \"id\": 2000014,\n        \"name\": \"哈比卜\",\n        \"title\": \"能干的厨师\",\n        \"text\": \"厨艺和刀工都很厉害的厨师，能熟练地拆解牲畜的尸体，炖煮喂饱军队的手抓饭，也能把水果拼接成美丽的装饰，令妇人们喜悦。如果可以提供恰当的灵感来源或者优秀食材，可以随时找哈比卜为你烹饪一顿大餐。\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"char\",\n        \"tips\": \"\",\n        \"rare\": 2,\n        \"resource\": \"cards/2000014\",\n        \"tag\": {\n            \"体魄\": 2,\n            \"魅力\": 2,\n            \"智慧\": 2,\n            \"男性\": 1,\n            \"社交\": 1,\n            \"战斗\": 1,\n            \"纯色材质\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [\n            \"武器\",\n            \"服装\",\n            \"饰品\"\n        ],\n        \"is_only\": 1\n    },\n    \"2000018\": {\n        \"id\": 2000018,\n        \"name\": \"货郎\",\n        \"title\": \"未启用\",\n        \"text\": \"货郎\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"char\",\n        \"tips\": \"\",\n        \"rare\": 1,\n        \"resource\": \"cards/2000018\",\n        \"tag\": {\n            \"体魄\": 2,\n            \"魅力\": 2,\n            \"智慧\": 2,\n            \"男性\": 1,\n            \"纯色材质\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [\n            \"武器\",\n            \"服装\",\n            \"饰品\"\n        ],\n        \"is_only\": 1\n    },\n    \"2000019\": {\n        \"id\": 2000019,\n        \"name\": \"热娜\",\n        \"title\": \"珠宝商\",\n        \"text\": \"珠宝商，在权力的游戏，浴场里的消息和书店营业中出场可以累计【灵感】。在俺寻思中出场可以消耗【灵感】为你设计饰品。\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"char\",\n        \"tips\": \"\",\n        \"rare\": 2,\n        \"resource\": \"cards/2000019\",\n        \"tag\": {\n            \"体魄\": 1,\n            \"魅力\": 3,\n            \"智慧\": 3,\n            \"女性\": 1,\n            \"贵族\": 1,\n            \"支持\": 1,\n            \"纯色材质\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [\n            \"武器\",\n            \"服装\",\n            \"饰品\"\n        ],\n        \"is_only\": 1\n    },\n    \"2000021\": {\n        \"id\": 2000021,\n        \"name\": \"伊曼\",\n        \"title\": \"正教的祭司\",\n        \"text\": \"自幼侍奉神明的祭司，他那毋庸置疑、一以贯之的虔诚难道也有其裂痕吗？\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"char\",\n        \"tips\": \"\",\n        \"rare\": 3,\n        \"resource\": \"cards/2000021\",\n        \"tag\": {\n            \"体魄\": 1,\n            \"魅力\": 5,\n            \"智慧\": 5,\n            \"男性\": 1,\n            \"贵族\": 1,\n            \"正教的信徒\": 1,\n            \"爱书人\": 1,\n            \"银趴绝缘者\": 1,\n            \"反对\": 1,\n            \"纯色材质\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [\n            \"武器\",\n            \"服装\",\n            \"饰品\"\n        ],\n        \"is_only\": 1\n    },\n    \"2000022\": {\n        \"id\": 2000022,\n        \"name\": \"拜铃耶\",\n        \"title\": \"邪术师\",\n        \"text\": \"除了源于正神的恩赐之外，一切魔术与神明的研究者理论上讲都可以称为邪术师。但你知道这个女人不一样，她那布满纹身的肌肤之下，有着更黑暗，也更吸引你的东西……\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"char\",\n        \"tips\": \"\",\n        \"rare\": 2,\n        \"resource\": \"cards/2000022\",\n        \"tag\": {\n            \"体魄\": 1,\n            \"魅力\": 3,\n            \"智慧\": 5,\n            \"魔力\": 5,\n            \"黑暗知识\": 1,\n            \"女性\": 1,\n            \"密教徒\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [\n            \"武器\",\n            \"服装\",\n            \"饰品\"\n        ],\n        \"is_only\": 1\n    },\n    \"2000023\": {\n        \"id\": 2000023,\n        \"name\": \"塔拉勒\",\n        \"title\": \"未启用\",\n        \"text\": \"宫廷画家\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"char\",\n        \"tips\": \"\",\n        \"rare\": 2,\n        \"resource\": \"cards/2000023\",\n        \"tag\": {\n            \"体魄\": 1,\n            \"魅力\": 3,\n            \"智慧\": 1,\n            \"男性\": 1,\n            \"纯色材质\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [\n            \"武器\",\n            \"服装\",\n            \"饰品\"\n        ],\n        \"is_only\": 1\n    },\n    \"2000024\": {\n        \"id\": 2000024,\n        \"name\": \"苏丹\",\n        \"title\": \"统治者\",\n        \"text\": \"他曾经是一位睿智，强悍，精明的统治者。不过你知道，他同时也残忍，疯狂，冷漠，不因为这些卡牌，这就是他的本性。\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"char\",\n        \"tips\": \"\",\n        \"rare\": 4,\n        \"resource\": \"cards/2000024\",\n        \"tag\": {\n            \"体魄\": 3,\n            \"魅力\": 3,\n            \"智慧\": 3,\n            \"男性\": 1,\n            \"贵族\": 1,\n            \"苏丹专属\": 1,\n            \"苏丹\": 1,\n            \"纯色材质\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [\n            \"武器\",\n            \"服装\",\n            \"饰品\"\n        ],\n        \"is_only\": 1\n    },\n    \"2000028\": {\n        \"id\": 2000028,\n        \"name\": \"胡拉菲\",\n        \"title\": \"未启用\",\n        \"text\": \"（商盟会长）这个总在微笑的男人掌握着这片大陆近七成的贸易路线