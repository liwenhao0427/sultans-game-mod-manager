module.exports = "{\n    \"id\": 9008050,\n    \"name\": \"重逢\",\n    \"text\": \"对于苏丹而言，针对哲瓦德的闹剧或许只是一个玩笑，但对于哲瓦德父女而言，这是命运最为残酷的礼物。现在，事情渐渐为人们所淡忘，你也总算是能够为这对父女做点什么了，经过多日的运作，你终于可以安排这对父女重逢了。\",       \n    \"tips\": \"\",\n    \"mapping_id\":8001044,  \n    \"once_new\":0,\n    \"round_number\": 1,\n    \"waiting_round\":5,\n    \"waiting_round_end_action\":[\n        {\n            \"condition\":\n            {\n                \n            },\n            \"result_title\":\"\",\n            \"result_text\": \"\",\n            \"result\": \n            {   \n\n            },\n            \"action\":\n            {    \n                \"prompt\": {\n                    \"id\": \"prompt_9008050_01\",\n                    \"text\": \"机会稍纵即逝，阿鲁米娜与哲瓦德再也没能相见。\",\n                    \"icon\":\"cards/2000774\"\n                }\n            }\n        }\n    ],\n    \"method_settlement\": \"\",\n    \"auto_begin\": 0,\n    \"auto_result\":0,\n    \"location\": \"黑街:[1,5]\", \n    \"icon\": \"rite_16\", \n    \"tag_tips\": [\n    ],\n    \"tag_tips_up\":{\n    },\n    \"tips_text\":[\n\n    ],\n    \"open_conditions\": [\n    \n    ],\n    \"random_text\":{\n    },\n    \"random_text_up\":{\n    },\n    \"settlement_prior\": [\n    \n    ],                \n    \"settlement\": [\n        {\n            \"condition\":\n            {\n                \"!s3\":1     //你没去\n            },\n            \"result_title\":\"还是留给她们父女一些私人空间吧\",\n            \"result_text\": \"你很高兴地听说他们父女两再次重逢了，最终逃往一个没有噩梦的地方。\",\n            \"result\": \n            { \n                \n            },\n            \"action\":\n            {\n                \n            }\n        },\n        {\n            \"condition\":\n            {\n                \"s3\":1     //你去了\n            },\n            \"result_title\":\"相拥落泪\",\n            \"result_text\": \"是夜，骤降的暴雪猛烈地砸在黑街漏风的屋棚，在一处霉烂的干草堆里，你找到了哲瓦德。\\n他破旧的毡靴陷在雪里，露出冻紫的脚趾，昔日翡翠扳指的位置也被冻疮啃得红肿，整个人仿佛苍老了十岁。除了因为夜夜蜷缩而愈发佝偻的身影，没有人能把他和昔日珠光宝气的大贵族联系在一起。\\n看到你来了，哲瓦德显得尤为激动，他挥挥手打断了你让人找来滚水寒裘的呼喝，颤颤巍巍地从怀里掏出一堆垫起来保暖的羊皮纸，口齿不清地说：“快……快去……”你这才发现，他塞给你的是一叠当票存根，最后一次续当的日期是今天清晨，代价则是他最后一颗金牙，而即将断当的——正是阿鲁米娜的面纱与项链。\\n你不禁有些愕然，但还是连忙扶住这个仿佛快要散架的老人。你终于明白是什么支撑着这个年过六旬的老人度过这一个个寒夜了，指示快脚赶紧去给这些首饰赎回或是续当。\\n就在哲瓦德眼神躲闪的想要说点什么的时候，他突然僵住了。你的身后是急忙赶来的阿鲁米娜。她没有受到苏丹密探太多的关注，在你的暗中关照下，她并没有受到真正的侵害，至少不至于挣扎于生死的边缘。而腐玉膏的效果也逐渐为月光中和，粗布衣也难掩她新生的雪白肌肤。至于她满头的银发，更是在月色与雪色间平添了第三抹绝色。\\n哲瓦德的大手一时间显得有些无处安放，这个可怜的小老头此时竟像一个做错事的孩子，满脸的窘迫与不安。就在阿鲁米娜已经无法压抑自己的哽咽之时，他挣扎着推开了你，转过身去蹒跚地想要逃离。\\n就在这时，恰如十年前妻子落葬的那天，阿鲁米娜紧紧地抱住了这个肥胖的、油腻的、恶臭的、无聊的——最爱她的——父亲：“爸爸，我好怕，你不要离开我。”\\n两行浑浊的热泪从哲瓦德深凹的眼窝中涌出，在雪地上烫出点点银斑。有些畏缩地，有些惶恐地，他最终还是抱住了他的珍宝。太多的歉意、太多的悔意、连同无数个牵肠挂肚的星夜，这都显然远超言语的力量所及。\\n铃舌在些微变形的腔内肆意舞蹈，其声清脆悠长，宛若夜莺于月下自由地歌唱。\\n次日，你的宅邸里多了一名胖管家和他的掌上明珠。\",\n\t\t\t\"result\": \n            { \n                 \"s1+追随者\":1\n            },\n            \"action\":\n            {\n                \"delay\":{\n                    \"id\":90080502,\n                    \"round\": 1,\n                    \"event_on\":9321056  //娇俏的访客\n                }\n                \n            }\n        }\n    ],                \n    \"settlement_extre\": [\n       \n    ],\n    \"cards_slot\":\n    {\n        \"s1\":\n        {\n            \"condition\": \n            {\n                \"type\":\"char\",\n                \"is\":2000057\n            },\n            \"open_adsorb\":1,\n            \"is_key\":0,\n            \"is_empty\":0,\n            \"is_enemy\":0,\n            \"text\":\"饥寒交迫的哲瓦德\" \n        },\n        \"s2\":\n        {\n            \"condition\": \n            {\n                \"type\":\"char\",\n                \"is\":2000774\n            },\n            \"open_adsorb\":1,\n            \"is_key\":0,\n            \"is_empty\":0,\n            \"is_enemy\":0,\n            \"text\":\"寻觅父亲的阿鲁米娜\" \n        },\n        \"s3\":\n        {\n            \"condition\": \n            {\n                \"主角\":1,\n                \"type\":\"char\"\n            },\n            \"open_adsorb\":0,\n            \"is_key\":0,\n            \"is_empty\":1,\n            \"is_enemy\":0,\n            \"text\":\"你真的舍得不去这场重逢？\" \n        }\n    }\n} ";