module.exports = " {\n        \"id\": 5000651,\n        \"name\": \"血的妆造\",\n        \"text\": \"娜依拉又想到了新的玩法——她邀请你用一张杀戮苏丹卡来处决自己手下最桀骜不驯的男奴。这想必能为你们俩增添无穷的情趣。\",       \n        \"tips\": \"\",\n        \"mapping_id\":8001176, \n        \"once_new\":0,\n        \"round_number\": 1,\n        \"waiting_round\":7, \n        \"waiting_round_end_action\":[\n            {\n                \"condition\": {\n                },\n                \"result_title\":\"\",\n                \"result_text\": \"\",\n                \"result\": \n                { \n                    \"s1=支持\":0,\n                    \"s1+反对\":5,\n                    \"counter+7000058\":1 \n                },\n                \"action\": {\n                    \"counter+7100002\": 1, //恶名+1\n                    \"prompt\": {\n                        \"id\": \"prompt_5000651_01\",\n                        \"text\": \"她写了一封辞藻华丽，充满挑逗的信件，与那游牧民的头颅一起寄给你，但你明白，之后再遇见她可就不妙了。\"\n                    }\n                }\n            }\n        ],\n        \"method_settlement\": \"\",\n        \"auto_begin\": 0, \n        \"auto_result\": 0, //自动执行                           \n        \"location\": \"上城区:[7,12]\", \n        \"icon\": \"rite_12\",  \n        \"tag_tips\": [\n        ],\n        \"tag_tips_up\":{\n        },\n        \"tips_text\":[\n            \"石杀戮可以杀死一位奴隶，而银杀戮则可以……但话说回来，如果是铜杀戮，或有着奇妙的效果也说不定？\"\n        ],\n        \"open_conditions\": [  \n        ],\n        \"random_text\": { \n        },\n        \"random_text_up\":{\n        },\n        \"random_effect\": {          \n        },\n        \"settlement_prior\": [\n        ],                \n        \"settlement\": [\n            {\n                \"condition\": {\n                    \"s4.rare=\":1\n                },\n                \"result_title\":\"\",\n                \"result_text\": \"她仿佛一位女修士，谦卑又神圣，除去了你们的衣衫，拉着你的手，用金刀切开了那奴隶健壮而多毛的胸膛。切口平滑、美丽，宛若敬神的祭礼。\\n她捧起鲜血，在自己身体上勾勒出妆容与衣衫，又掏出那还在跳动的心脏，踮起脚来，举过你的头顶，好似在膏一位加冕的国王。\\n血液顺着你的额头流下，迷蒙了你的双眼，你只听得到心脏被挤压的噗噗声，你只感觉到她的双乳与呼吸在你皮肤上的摩擦声。\",\n                \"result\": \n                { \n                    \"clean.s2\":1\n                },\n                \"action\": {\n                }\n            },\n\t\t\t{\n                \"condition\": {\n                    \"s4.rare=\":2\n                },\n                \"result_title\":\"\",\n                \"result_text\": \"“真是令人犯难呢？”你皱了皱眉头故作烦恼地说道，“今天好像带错卡了？你说怎么办呢？”\\n看着你不断把玩的铜杀戮，娜依拉被吓得花容失色，她从未想过自己只是邂逅了权力，而并非是权力的主宰。但很快，不可一世的傲慢或是疯狂又回来了，她毫无血色的脸上又开始泛起红晕。“最艳丽的红妆，当然要用自己的鲜血染就，也只能用自己的鲜血染就！”她暗暗想到，随即眼中闪烁起无尽的疯狂与渴望。\\n然而，这还是难掩她不住颤抖的身躯，这当然可能是出自兴奋，却也未尝不是出自恐惧。就像落入陷阱的雪貂，临死了仍在高昂自己的头颅。\\n这已经足够了。\\n于是，正当翡翠匕首划破她雪白脖颈，就要取颈间血以作新酿的时候——你冷笑一声：“亲爱的，真正的艺术品需要瑕疵作衬，正如你的骄傲要以恐惧佐餐。”\\n一时间生存的喜悦与受辱的愤怒冲上脑海，娜依拉僵住了，但这腥甜的气息旋即让她恢复了冷静。“大人，您也应该尝尝这新进的波斯玫瑰盐。”她轻笑道，悄无声息地抓起桌上的金刀，“毕竟，完整的瓷器…”尾音淹没在陡然贴近的吐息里，金刀也顺势向上划开你的胸膛，“…摔起来才最是悦耳。”\\n最后，娜依拉故作冷淡地表示她手下的奴隶完全值得一张铜杀戮，留下血泊中疼痛不起的你便转身离去了。\",\n                \"result\": \n                { \n                    \n                },\n                \"action\": {\n                }\n            },\n            {\n                \"condition\": {\n                    \"s4.rare=\":3\n                },\n                \"result_title\":\"\",\n                \"result_text\": \"这是一张配得上你的杀戮卡，你这样告诉她，顺势拿走了她手上的金刀，然后用锁链扣住了她的脖颈。\\n随后，你解开了那游牧民奴隶的绳索，把武器与时间留给了他。\",\n                \"result\": \n                { \n                    \"clean.s1\":1\n                },\n                \"action\": {\n                }\n            }\n        ],                \n        \"settlement_extre\": [\n            {\n                \"condition\": {\n                    \"s4.rare=\":1\n                },\n                \"result_title\":\"\",\n                \"result_text\": \"当你回过神来之后，你们已经气喘吁吁，躺在内脏与血泊之中，精疲力尽……\\n她轻柔地舔掉你耳朵里的血块，低声言语道：我好像有点爱上你了。\",\n                \"result\": \n                { \n                    \"s1+激情\":1,\n                    \"s1+支持\":1,\n                    \"clean.s4\":1,\n                    \"s1+追随者\":1\n      