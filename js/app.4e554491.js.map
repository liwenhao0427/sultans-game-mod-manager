\n        \"type\": \"item\",\n        \"tips\": \"\",\n        \"rare\": 4,\n        \"resource\": \"cards/2000818\",\n        \"tag\": {\n            \"装备\": 1,\n            \"饰品\": 1,\n            \"战斗\": 4,\n            \"已装备\": 1,\n            \"装备商人\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [],\n        \"is_only\": 0\n    },\n    \"2000819\": {\n        \"id\": 2000819,\n        \"name\": \"征战护身符\",\n        \"title\": \"饰品\",\n        \"text\": \"一个可以打开的银匣，内衬着红色的天鹅绒，匣子中装有一张叠的紧紧的纸条，那上面写着：“死亡一百人，死亡的也不要是我的爱人；存活一个人，存活的就一定是我的爱人”。\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"item\",\n        \"tips\": \"\",\n        \"rare\": 2,\n        \"resource\": \"cards/2000819\",\n        \"tag\": {\n            \"装备\": 1,\n            \"饰品\": 1,\n            \"生存\": 2,\n            \"已装备\": 1,\n            \"装备商人\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [],\n        \"is_only\": 0\n    },\n    \"2000820\": {\n        \"id\": 2000820,\n        \"name\": \"玉石臂环\",\n        \"title\": \"饰品\",\n        \"text\": \"一只漂亮的玉环，瘦削的人当臂环用，强壮的人可能只能勉强当手镯佩戴。\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"item\",\n        \"tips\": \"\",\n        \"rare\": 1,\n        \"resource\": \"cards/2000820\",\n        \"tag\": {\n            \"装备\": 1,\n            \"饰品\": 1,\n            \"魅力\": 1,\n            \"已装备\": 1,\n            \"装备商人\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [],\n        \"is_only\": 0\n    },\n    \"2000821\": {\n        \"id\": 2000821,\n        \"name\": \"石榴园\",\n        \"title\": \"饰品\",\n        \"text\": \"这是一件最美丽的额饰，它的作者是一位出身贵族的能工巧匠，在家族覆灭之后，她躲到乡下苟且偷生，还好得到了某位权臣的友情、从而回到了锻金台前。这件珠宝的灵感来自于工匠的一个梦，梦中，她回到了自己家族的花园，石榴花盛开，喷泉流淌，人们的脸上笑意连连……\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"item\",\n        \"tips\": \"\",\n  