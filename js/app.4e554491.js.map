module.exports = "{\n    \"id\": 5000767,\n    \"name\": \"肉体展览\",\n    \"text\": \"三名女奴被拴在奴隶贩子的身后，站成一排，供客人挑选。你可以加入奈布哈尼的消遣游戏，出一半的钱，选一位或多位买下来，给她或她们自由。\",       \n    \"tips\": \"\",\n    \"once_new\":0,\n    \"round_number\": 1, \n    \"waiting_round\":2,\n    \"waiting_round_end_action\":[\n        {\n            \"condition\": {\n            },\n            \"result_title\":\"\",\n            \"result_text\": \"\",\n            \"result\": \n            {\n            },\n            \"action\": {\n                \"counter-7100003\":1,  //权势-1\n                \"prompt\":{\n                    \"id\":\"5000767_prompt_01\",\n                    \"text\":\"你随口答应之后，忘记了这件事，把奈布哈尼抛在脑后，让他有点生气。\",\n                    \"icon\":\"cards/2000001\"\n                }\n            }\n        }\n    ],\n    \"method_settlement\": \"\",\n    \"auto_begin\": 0,\n    \"auto_result\":0,\n    \"location\": \"上城区:[1,6]\", \n    \"icon\": \"rite_6\",  \n    \"tag_tips\": [\n\n    ],\n    \"tag_tips_up\":{\n\n    },\n    \"tips_text\":[\n        \"3金币即可购买一位，若为某一女奴置入6金币，则可折断一张奢靡卡。\",\n        \"可以购买多位，当然，你也可以不放钱，拒绝这次交易。\"\n    ],\n    \"open_conditions\": [\n    ],\n    \"random_text\": {        \n\n    },\n    \"random_text_up\":{\n        \n    },\n    \"random_effect\": {          \n    },\n    \"settlement_prior\": [\n        {\n            \"condition\": {\n                \"!s6\":1,\n                \"!s7\":1,\n                \"!s8\":1  //都不放钱\n            },\n            \"result_title\":\"我讨厌这种交易。\",\n            \"result_text\": \"你摇摇头，告诉他你很讨厌这种交易，把人像一块肉一样地公开展览，实在令人不适。\\n他笑着说你伪善，你家不也有很多奴隶吗？你的宅邸不也是靠着女奴跪在地上磨损膝盖才打扫干净的吗？\\n他为自己选了皮肤最白的那个女奴。然后付了钱。这次娱乐算不上十分让人开心，但你们对彼此的了解又深了一层。\",\n            \"result\": \n            {\n                \"counter+7100001\":1  //善名+1\n            },\n            \"action\": {\n                \n            }\n        }\n    ],                \n    \"settlement\": [\n        \n    ],                \n    \"settlement_extre\": [\n\t\t{\n            \"condition\": {\n                \"s6\":1  \n            },\n            \"result_title\":\"你提议买下蛮族的女奴\",\n            \"result_text\": \"一手交钱、一手交货之后，这名女奴被带到你们跟前，即使你们是她的主人了，但她的眼神依旧桀骜不驯，犹如豺狼。\\n“你自由了。”奈布哈尼说，“我跟这位大人一起买下了你，然后，我们打算放了你。”\\n“如果需要工作的话，也可以来我的宅邸找我。”你打量着她结实的肌肉，补充道。奈布哈尼闻言却大声笑了，他亲昵地撞了你一下：“工作？女人不需要工作，你让她去找你，是因为你想纳个妾？”\\n你无语地看着他俊朗的、养尊处优的侧脸，还有他这身让所有人侧目、却又无人敢质疑的铁卫衣装。奈布哈尼对善良有着自己的定义，他向女孩们播撒的善意或许是真的，但……\\n在你们说话的空隙，那名蛮族少女不再过多迟疑，果断地转身逃走了，转瞬就消失在人群之中。\\n“她会去做什么呢？会遇到某个人，然后缔结婚约、生个孩子吗？”奈布哈尼饶有兴致地微笑着，“希望我以后别在妓馆里见到她，我可真在那种地方见过被我救下来的淑女呢。”\",\n            \"result\": \n            {\n                \"counter+7000306\":1,  //表明解救了芮尔\n                \"no_show\":{\n                    \"card\":2000771  //生成芮尔进入卡池\n                }\n            },\n            \"action\": {\n                \"event_off\":5300274,  //关闭烧奴隶市场事件\n                \"event_on\":5300539  //帮派斗争触发\n            }\n        },\n        {\n            \"condition\": {\n                \"s7\":1  \n            },\n            \"result_title\":\"你提议买下娇弱的女奴\",\n            \"result_text\": \"奴隶贩子微笑着，解开这名少女手上的绳索，不住地夸耀：“您可真有眼光！她是妓院里出生的孩子，从小就接受了全套的训练——您懂的！这次您可真是赚大了！”\\n对待这样柔弱美丽的女孩，奈布哈尼总是格外温柔：“亲爱的，你自由了。”他亲自替她解开了镣铐，“我会烧掉你的奴隶纸，还你自由人的身份，你可以自由自在地生活了。”\\n“可是……可是……”少女却无所适从地睁大了眼睛，她跪在地上，凄惶而惊恐地抓紧他的衣角，“求求您，不要抛下我……我——我不想自由的生活——我想您买下我！我来伺候您！我……求您了！”\\n奈布哈尼似乎有些尴尬，他看看这名你们一起掏钱买下来的女奴，又看看你：“您觉得呢？”\",\n            \"result\": \n            {\n                \"counter+7000307\":1  //表明解救了索拉薇儿\n            },\n            \"action\": {\n                //\"event_off\":5300274,  //关闭烧奴隶市场事件\n                \"event_on\": 5300276\n            }\n        },\n        {\n            \"condition\": {\n                \"s8\":1  \n            },\n            \"result_title\":\"你买下了女工匠。\",\n            \"result_text\": \"你们把钱付了，然后，奈布哈尼把那张奴隶书当着女工匠的面撕碎了。\\n“你已经不需要主人了，亲爱的……”他瞟了一眼奴隶书的碎片上记载的名字，“哈布娜，我和这位[player.name]大人买下你，就是为了给你自由。”\\n哈布娜睁大眼，震惊地望着你们俩。而后，她释然地笑了，神情中满是喜悦与放松。\\n“这太好了……这简直是无法想象的好运气，自由，天哪，我重新自由了！”\\n她跪倒在地，轮流亲吻了你们俩的脚。\\n“如果两位大人允许的话，我想走了，我要去找个能赊账的房子，然后再赊一些布和线……”哈布娜迅速地说着、盘算着。\\n你们也高兴地给了她祝福。\",\n            \"result\": \n            {\n                \"counter+7000308\":1  //表明解救了哈布娜\n            },\n            \"action\": {\n                //\"event_off\":5300274,  //关闭烧奴隶市场事件\n                //\"event_on\": 5300289\n            }\n        },\n        {\n            \"condition\": {\n                \"s5\":1,\n                \"any\":{\n                    \"s6.金币>=\":6 ,\n                    \"s7.金币>=\":6 ,\n                    \"s8.金币>=\":6 \n                }\n                \n            },\n            \"result_title\":\"\",\n            \"result_text\": \"你向奈布哈尼表示自己会付全款，他笑着看向你手中的奢靡卡，表示自己不会阻止你的慷慨。\",\n            \"result\": \n            {\n                \"clean.s5\":1 //消除苏丹卡\n            },\n            \"action\": {\n                \n            }\n        }\n    ],\n    \"cards_slot\":\n    {\n        \"s1\":\n        {\n            \"condition\":\n            {\n                \"is\": 2000770               \n            },\n            \"open_adsorb\":1,\n            \"is_key\":0,\n            \"is_empty\":0,\n            \"is_enemy\":0,\n            \"text\":\"这名女奴的皮肤上有着蛮族战士的刺青，看起来得非常桀骜不驯\"\n        },\n        \"s2\":\n        {\n            \"condition\":\n            {\n                \"is\": 2000851             \n            },\n            \"open_adsorb\":1,\n            \"is_key\":0,\n            \"is_empty\":0,\n            \"is_enemy\":0,\n            \"text\":\"这名女奴紫罗兰色的大眼睛里蓄满泪水，看起来美丽娇弱、楚楚可怜\"\n        },\n        \"s3\":\n        {\n            \"condition\":\n            {\n                \"is\": 2000852          \n            },\n            \"open_adsorb\":1,\n            \"is_key\":0,\n            \"is_empty\":0,\n            \"is_enemy\":0,\n            \"text\":\"这名女奴表情镇定，她的双手都是老茧，看起来像是熟练的工匠\"\n        },\n        \"s4\":\n        {\n            \"condition\":\n            {\n                \"is\": 2000064              \n            },\n            \"open_adsorb\":1,\n            \"is_key\":0,\n            \"is_empty\":1,\n            \"is_enemy\":0,\n            \"text\":\"奈布哈尼兴致盎然\"\n        },\n        \"s5\":\n        {\n            \"condition\":\n            {\n                \"type\":\"sudan\",\n                \"奢靡\":1,                        \n                \"f:rare-s1.rare<=\":0           \n            },\n            \"open_adsorb\":0,\n            \"is_key\":0,\n            \"is_empty\":1,\n            \"is_enemy\":0,\n            \"text\":\"你可以借此折断一张不高于奴隶品级的奢靡卡\"\n        },\n        \"s6\":\n        {\n            \"condition\":\n            {\n                //\"!s7\":1,\n                //\"!s8\":1,\n                \"type\":\"item\",\n                \"cost.金币\":[3,6]            \n            },\n            \"open_adsorb\":0,\n            \"is_key\":0,\n            \"is_empty\":1,\n            \"is_enemy\":0,\n            \"text\":\"购买蛮族的女奴，3金币即可，若置入6金币，则可折断一张奢靡卡\"\n        },\n        \"s7\":\n        {\n            \"condition\":\n            {\n                //\"!s6\":1,\n                //\"!s8\":1,\n                \"type\":\"item\",\n                \"cost.金币\":[3,6]            \n            },\n            \"open_adsorb\":0,\n            \"is_key\":0,\n            \"is_empty\":1,\n            \"is_enemy\":0,\n            \"text\":\"购买娇弱的女奴，3金币即可，若置入6金币，则可折断一张奢靡卡\"\n        },\n        \"s8\":\n        {\n            \"condition\":\n            {\n                //\"!s6\":1,\n                //\"!s7\":1,\n                \"type\":\"item\",\n                \"cost.金币\":[3,6]            \n            },\n            \"open_adsorb\":0,\n            \"is_key\":0,\n            \"is_empty\":1,\n            \"is_enemy\":0,\n            \"text\":\"购买有手艺的女奴，3金币即可，若置入6金币，则可折断一张奢靡卡\"\n        }\n    }\n} ";