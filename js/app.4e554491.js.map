module.exports = "{\n    \"id\": 9008049,\n    \"name\": \"一语成谶\",\n    \"text\": \"阿鲁米娜从未想过，此前随口许下的誓言，应验得如此之快。但无论如何，想要拯救她就需要一众各有所长的同伴，配合哲瓦德演好这出恩断义绝的悲剧。\",       \n    \"tips\": \"\",\n    \"once_new\":0,\n    \"round_number\": 1,\n    \"waiting_round\":1,\n    \"waiting_round_end_action\":[\n\t\t{\n                \"condition\": {\n                    \n                },\n                \"result_title\":\"\",\n                \"result_text\": \"阿鲁米娜悲惨地死去了。\",\n                \"result\": \n                {\n                    \n                }\n            }\n    ],\n    \"method_settlement\": \"\",\n    \"auto_begin\": 0,\n    \"auto_result\":0,\n    \"location\": \"黑街:[2,5]\", \n    \"icon\": \"rite_3\", \n    \"tag_tips\": [\n            \"隐匿\",\n\t\t\t\"智慧\",\n            \"生存\",\n            \"社交\"\n        ],\n    \"tag_tips_up\":{\n            \"tips\":[\"隐匿\",\"智慧\",\"生存\",\"社交\"],\n            \"type\":\"normal_result\"\n        },\n    \"tips_text\":[\n        \"你能做的不是欺骗，而是让苏丹无所谓被骗与否，都品尝到折磨哲瓦德的快感，因此这幕戏剧必须用父亲的血泪来写就。\"\t\"哲瓦德的剧本与演绎必须真实可信，这需要智慧。\"\t\"组织这一场瞒天过海的悲剧需要黑街三教九流的帮助，这需要隐匿。\"\t\"阿鲁米娜在吃人不吐骨头的黑街暂时求生需要人暗中帮助，这需要生存。\"\t\"为了善后需要打点好宫内上下尤其是苏丹近侍，这需要社交\"\n    ],\n    \"open_conditions\": [\n    ],\n    \"random_text\":{\n        \"r1\":\"黑街的众人与灵丹妙药。\",\n        \"r2\":\"哲瓦德开始了他的表演。\",\n        \"r3\":\"阿鲁米娜在黑街艰难求生。\",\n        \"r4\":\"在宫廷内部上下打点。\"\n    },\n    \"random_text_up\":{\n\t\t\"r1\":{\n                \"text\":\"黑街的众人与灵丹妙药。\",\n                \"type\":\"normal_result\",\n                \"type_tips\":\"[s1.name]和[s3.name]的隐匿为你提供了完整的骰子数量。\",\n                \"low_target\": 3,\n                \"low_target_tips\": \"你至少需要3点成功才能搜集并制造出阿鲁米娜毁容堕落的效果。\"\n            },\n            \"r2\":{\n                \"text\":\"哲瓦德开始了他的表演。\",\n                \"type\":\"normal_result\",\n                \"type_tips\":\"[s1.name]和[s4.name]的智慧为你提供了完整的骰子数量。\",\n                \"low_target\": 3,\n                \"low_target_tips\": \"你至少需要3点成功才能让苏丹信以为真。\"\n            },\n            \"r3\":{\n                \"text\":\"阿鲁米娜在黑街艰难求生。\",\n                \"type\":\"normal_result\",\n                \"type_tips\":\"[s2.name]和[s5.name]的生存为你提供了完整的骰子数量。\",\n                \"low_target\": 3,\n                \"low_target_tips\": \"你至少需要3点成功才能让阿鲁米娜在黑街幸存。\"\n            },\n            \"r4\":{\n                \"text\":\"在宫廷内部上下打点。\",\n                \"type\":\"normal_result\",\n                \"type_tips\":\"[s1.name]和[s6.name]的社交为你提供了完整的骰子数量。\",\n                \"low_target\": 3,\n                \"low_target_tips\": \"你至少需要3点成功才能避免事后引起苏丹的猜忌。\"\n            }\n      \n    },\n    \"settlement_prior\": [\n    ],                \n    \"settlement\": [\n        {\n            \"condition\": {\n                \n            },\n            \"result_title\":\"一语成谶\",\n            \"result_text\": \"哲瓦德站在黑街破烂的讲台上，脚下踩着家族徽旗，黑街的风裹着腐臭灌进他绣金长袍。\\n“阿鲁米娜——”他的声音像生锈的绞盘，嘶哑地念出这个承载他无尽柔情的名字，“玷污亲族，有负圣恩，吾以第九代家主之名，将你逐出门庭，流放于此，任你自生自灭，永不复还。”\",\n            \"result\": \n            {\n            },\n            \"action\": {\n\n            }\n        }\n    ],                \n    \"settlement_extre\": [\n\t{\n                \"condition\": {\n                    \"r1:s1.隐匿+s3.隐匿>=\":[3,5]  //隐匿检定成功\n                },\n                \"result_title\":\"腐玉膏与本色出演\",\n                \"result_text\": \"黑市刑台上飘着腐肉与檀香混杂的异臭，阿鲁米娜颈间溃烂的伤口淌着翡翠色脓液，像条毒蛇般盘踞在昔日雪白的脖颈——只可惜这次新项链书写的不是荣光而是屈辱。\\n黑街众人哄笑如秃鹫群聚，他们乐得看到昔日明珠被铁链拴在污水渠旁。\\n只见少女脖颈处的烂疮流着脓血，散发处死鱼般的恶臭的腥气——那都要“归功于”黑街常客[s3.name]特制的「腐玉膏」，这些疮疤遇月光便会结成可剥落的琥珀壳。\\n在黑街居民的欢呼声中，腐臭的内脏、腐坏的果蔬连着屎尿唾沫如雨点般飞向那昔日里不可一世的少女。欺辱他人算是身处底层的黑街民众们少有的娱乐，无情地玷污那头傲人的银发更能唤起他们久违的优越感。\\n早有安排的醉汉与疯丐更是一拥而上，少女的脸色早已吓得煞白，那破碎而恐惧眼神令[s3.name]心生悔意，但事已至此，接下来就轮到哲瓦德的表演了。\",\n                \"result\": \n                {\n                    \n                },\n                \"action\": {      \n                    \n                }\n            },\n            {\n                \"condition\": {\n                    \"r1:s1.隐匿+s3.隐匿<\":[3,5]  \n                },\n                \"result_title\":\"\",\n                \"result_text\": \"阿鲁米娜悲惨的死去了。\",\n                \"result\": \n                {\n                    \n                },\n                \"action\": {      \n                    \n                }\n            },\n            {\n                \"condition\": {\n                    \"r2:s1.智慧+s4.智慧>=\":[3,5]  //智慧检定成功\n                },\n                \"result_title\":\"痛在我心\",\n                \"result_text\": \"眼见黑街的众人就要对阿鲁米娜实施侵犯，而人群中苏丹的密探也扬起鹰隼，于是哲瓦德咬咬牙，猛地甩出一鞭，狠狠地抽向阿鲁米娜的脊梁：“这一鞭，打你天生淫贱，滥交染毒，玷污绣有家徽的雪貂裘！”\\n“父亲……”那是阿鲁米娜吃痛时无意识地呼号，向着那个本该用生命，用尽一切保护她的男人呼救，清澈无知的大眼睛里写满了迷茫、恐惧与绝望。\\n阿鲁米娜始终都不明白，为什么一夜之间，她所拥有的一切都变得天翻地覆，标榜守护的利刃却将刀锋指向自己？\\n“为什么？我没有，我没有！爸爸，我会乖的，我会听话，我不开宴会，不偷看宫廷小说，不和男生玩了好吗爸爸？”泪水模糊了阿鲁米娜的双眼，带着绝望崩溃的哭腔，她颤抖着抓住哲瓦德的长袍下摆不住摇晃，“我知道错了，我再也不扯你的胡须，再也不踩水坑，再也不拿你窖藏的葡萄酒喂鹦鹉了好吗，我求你了爸爸，你最疼我的不是吗爸爸？”\\n“这一鞭，”哲瓦德紧咬牙关，长鞭呼啸着掠过阿鲁米娜雪白的臂膀，留下宛若烧灼般的血痕，“打你毫不自爱，罔负圣恩，无从侍奉伟大的苏丹！”\\n黑街的民众在一道道鞭影下四散躲开，唯有可怜的阿鲁米娜只能在污水渠旁蜷缩成一团，承受着无情的鞭笞，这确实是[s4.name]想要的效果，但即使是其本人也不忍直视。\\n这场闹剧持续了一个上午，终结于阿鲁米娜渐渐嘶哑的哭号中。呢喃着最后一句“爸爸，银铃怎么还没响呀？我好害怕。”便晕死在污水渠旁。哲瓦德用尽最后全身的力气强忍泪水，把银铃一摘、一甩、一跺，再是猛啐一口唾沫，骂道“你那生蛆的皮肉只配侍奉最卑贱的脚夫，我哲瓦德没你这个女儿！”\\n与此同时，[s4.name]在暗处默默祈祷贾丽拉的特制皮鞭能够发挥其应有的功效，这些所谓的“疤痕”应该不日便能恢复如初。\",\n                \"result\": \n                {\n                    \n                },\n                \"action\": {      \n                    \n                }\n            },\n            {\n                \"condition\": {\n                    \"r2:s1.智慧+s4.智慧<\":[3,5]  //战士检定失败\n                },\n                \"result_title\":\"\",\n                \"result_text\": \"阿鲁米娜悲惨地死去了。\",\n                \"result\": \n                {\n                    \n                },\n                \"action\": {      \n                    \n                }\n            },\n            {\n                \"condition\": {\n                    \"r3:s2.生存+s5.生存>=\":[3,5]  //生存检定成功\n                },\n                \"result_title\":\"艰难求生\",\n                \"result_text\": \"雨水裹着脓血在她脚边汇成腥臭的溪流，阿鲁米娜蜷缩在妓院后巷的烂菜堆里。那些溃烂的疮口像无数张嘲笑的嘴，撕咬着十七年来被父亲捧在手心的每一寸娇嫩肌肤。\\n暴雨总是容易过去的，正如真正幸福的日子难以长久。然而，真正苦难的日子又何尝不是呢？\\n眼见人群散去，[s5.name]手下的毛孩子们七手八脚地把阿鲁米娜抬去黑街深处。即使是泔水也能果腹，只怕死灰不愿复燃。\\n幸运的是，在[s5.name]的暗中照料的几日过后，她的面容虽然依旧苍白，却已经被削去了所有的稚嫩与戾气；遗憾的是，她的周围却再也没有那些华美成熟的服饰与之相衬了。\\n仍记得那天夜晚，[s5.name]没有多说什么，只是塞给她一个被笨拙手法撑得略显畸形的银铃，这让她想起那双只擅长玩弄金币的温暖大手。\\n附随的羊皮纸上如此写道：“噩梦很长，爸爸或许没法回来了。”\",\n                \"result\": \n                {\n                    \"card\":9000287,\n\t\t\t\t\t\"s2+隐匿\":2,\n                    \"s2+生存\":3,\n\t\t\t\t\t\"s2+智慧\":1,\n\t\t\t\t\t\"s2-贵族\":1\n                },\n                \"action\": {      \n                    \n                }\n            },\n            {\n                \"condition\": {\n                    \"r3:s2.生存+s5.生存<\":[3,5]  //生存检定成功\n                },\n                \"result_title\":\"\",\n                \"result_text\": \"阿鲁米娜悲惨地死去了。\",\n                \"result\": \n                {\n                    \n                },\n                \"action\": {      \n                    \n                }\n            },\n            {\n                \"condition\": {\n                    \"r4:s1.社交+s6.社交<\":[3,5]  //使节交涉失败\n                },\n                \"result_title\":\"\",\n                \"result_text\": \"阿鲁米娜悲惨地死去了。\",\n                \"result\": \n                {\n                    \n                },\n                \"action\": {      \n                    \n                }\n            },\n            {\n                \"condition\": {\n                    \"r4:s1.社交+s6.社交>=\":[3,5]  //交涉成功\n                },\n                \"result_title\":\"幕后事宜\",\n                \"result_text\": \"是夜，哲瓦德在苏丹殿前长跪：“臣家门不幸，已亲手剜去腐肉，如今有负皇恩，只求陛下赐臣一死，家产尽数充公为国，聊以自赎。”\\n “啧啧啧，”苏丹脸上挂满了恶毒的嘲弄，“真是令人哀痛，但哲瓦德，此前所说不过是个无伤大雅的玩笑罢了。我哪里舍得逼迫你这样忠心能干的大臣呢？”\\n哲瓦德本就强忍丧女之痛，被苏丹这么一激，更是气得目眦欲裂……盛怒之下，猛地站起身，颤抖地指着苏丹：“你……你你你……”\\n可惜，在苏丹的大笑声中，哲瓦德就这么原地僵住，捂着自己的胸口，痛苦地抽搐、喘息，口中竟不住地呕出鲜血——他就这么活生生晕死过去了。\\n“呵，”苏丹露出一个残忍而满足的微笑，对上前收尸的近卫挥了挥手：“扔到黑街，让他们……合家团聚。”\\n这一切都在你的预料之中，哲瓦德流露的冰冷仇恨并不能成为他的救命稻草——他太能干了，只有无能之辈才能凭借仇恨成为苏丹的宫廷小丑。\\n所以，哲瓦德死了，而黑街又多了一个老疯子。\\n而后，不出一天哲瓦德的家产就被各路贵族们吃干抹净。[s6.name]则从中不断斡旋，确保宫廷上下的每一个人都得到自己应有的那份，确保这件旧事无人再欲重提。\\n至于黑街的民众？在他们的眼里，贵族老爷、小姐的起起落落本就常事。在苏丹的治下，每天都有几个贵族流落黑街，每天又都有几个贵族头衔明码标价，谁又能想到这场闹剧的背后牵扯着苏丹的一时兴起呢？但话又说回来，阿鲁米娜在苏丹眼里也不过是一根点燃哲瓦德仇恨的导火索罢了。\",\n                \"result\": \n                {\n                    \"counter+7100001\":3,   //善名+3\n\t\t\t\t\t\"s1-追随者\":1\n                },\n                \"action\": {      \n                    \"delay\":{\n                        \"id\":90080491,\n                        \"round\": 5,\n                        \"rite\":9008050  //1回合后触发重逢，之后再改\n                    }\n                }\n            }\n    ],\n    \"cards_slot\":\n    {\n        \"s1\":\n            {\n                \"condition\": \n                {\n                    \"type\":\"char\",\n                    \"is\":2000057 //哲瓦德\n                },\n                \"open_adsorb\":1,\n                \"is_key\":0,\n                \"is_empty\":0,\n                \"is_enemy\":0,\n                \"text\":\"悲愤交加的哲瓦德\"\n            },\n\t\t\"s2\":\n            {\n                \"condition\": \n                {\n                    \"type\":\"char\",\n                    \"is\":2000774 //阿鲁米娜\n                },\n                \"open_adsorb\":1,\n                \"is_key\":0,\n                \"is_empty\":0,\n                \"is_enemy\":0,\n                \"text\":\"不知所措的阿鲁米娜\"\n            },\n\t\t\"s3\":\n            {\n                \"condition\": \n                {\n                    \"type\":\"char\",\n                    \"隐匿>=\":3\n                },\n                \"open_adsorb\":0,\n                \"is_key\":0,\n                \"is_empty\":0,\n                \"is_enemy\":0,\n                \"text\":\"一个在黑街吃得开的人\"\n            },\n\t\t\"s4\":\n            {\n                \"condition\": \n                {\n                    \"type\":\"char\",\n                    \"智慧>=\":3\n                },\n                \"open_adsorb\":0,\n                \"is_key\":0,\n                \"is_empty\":0,\n                \"is_enemy\":0,\n                \"text\":\"一个配合哲瓦德训练表演的人\"\n            },\n\t\t\"s5\":\n            {\n                \"condition\": \n                {\n                    \"type\":\"char\",\n                    \"生存>=\":3\n                },\n                \"open_adsorb\":0,\n                \"is_key\":0,\n                \"is_empty\":0,\n                \"is_enemy\":0,\n                \"text\":\"一个能暗中帮助阿鲁米娜生存的人\"\n            },\n\t\t\"s6\":\n            {\n                \"condition\": \n                {\n                    \"type\":\"char\",\n                    \"社交>=\":3\n                },\n                \"open_adsorb\":0,\n                \"is_key\":0,\n                \"is_empty\":0,\n                \"is_enemy\":0,\n                \"text\":\"一个能打点宫廷内外的人\"\n            }\n    }\n} ";