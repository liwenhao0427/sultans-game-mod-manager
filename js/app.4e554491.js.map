module.exports = "{\n    \"id\": 9321053,\n    \"text\": \"毒蛇吐信\",\n    \"is_replay\": 0, //是否可以重复触发\n    \"auto_start\": false, \n    \"start_trigger\": true, // 是否启动就立即开始校验条件\n    \"on\": { //时机\n         \"round_begin_ba\": 1\n    },\n    \"condition\": { //条件\n    \"all\":{\n        \"have.2000057\": 1, //哲瓦德还活着\n        \"have.2000774\": 1 //阿鲁米娜还活着\n    }\n    },\n    \"settlement\": [ //效果 \n    {\n        \"tips_resource\":\"\", \n        \"tips_text\":\"\",\n        \"action\":{\n            \"prompt\":{\n                \"id\":\"9321053_prompt_01\",\n                \"text\":\"苏丹的指尖不住地轻敲孔雀石王座，每一下都是哲瓦德的丧钟。\\n“哲瓦德，你养了只金丝雀。”苏丹对此饶有兴趣。\\n这让你想起了毒蛇吐信，苏丹显然是看清了什么才是这个贪婪的老贵族最为珍视的珠宝，而他即将品尝碾碎它时迫发出的苦痛、挣扎与绝望，伴随的愤怒与仇恨更是绝佳的前菜与甜点。\\n哲瓦德袖中的左手猛地攥紧——那里藏着一枚早已褪色的银铃，是阿鲁米娜五岁时系在他腕上的“驱噩梦法器”。\\n“陛下说笑了，那不过是一只爱啄石榴的蠢鸟。”仇恨、不甘、愤怒等种种情绪只在哲瓦德脸上一闪而过，转瞬间他又披回了那油滑而狡诈的外衣：“说来近日听闻西域有一巧匠又打造了只黄金鸟，其声宛若夜莺，臣这就去搜集来……”\\n“哲瓦德……”苏丹嘲弄地轻笑一声，有如裹了蜜糖的碎琉璃。这位暴君微微前倾身子，毒蛇嘶嘶吐信，“再精巧的黄金鸟儿，也无法发出夜莺被扼毙前悦耳的悲鸣。”\\n哲瓦德近乎要绝望了，他手中的银铃在不断发烫，汗水沁湿了外壁上亲手镌刻的符文。但他却还是拼命地挤出一丝谄笑：“尊敬的陛下，阿鲁米娜不过是一个毛都没长齐的……”\\n“毛都没长齐那就拔光它！”苏丹随手打翻了周遭的银烛台，伴随着它一同折断的还有老哲瓦德的脊梁，阴影中的苏丹显得更加阴鸷了。\\n一阵骇人的沉默过后，又是一声轻笑，苏丹恢复了他惯常的懒洋洋的声调：“给你一个慈悲，明天日落之前，玫瑰园里新培的‘路易十四’还需要新血来灌溉。”\\n在这昏暗的王座厅前，哲瓦德感到一阵晕眩，恍惚间他忆起十年前的那个夜晚，他也是这样跪在女儿的床前。\\n“不怕，银铃响时，爸爸为你杀噩梦。”\",\n                \"icon\":\"cards/sudan\"\n            },\n\t\t\t//\"delay\": {  //延迟1回合执行\n                    //\"id\":93210539,\n                    //\"round\": 1,\n                    \"event_on\": 9321054       //银铃作哑     \n                //} \n            \"success\":{\n                \"event_off\":9321053 //关闭\n            }\n        }\n    }\n    ]\n}";