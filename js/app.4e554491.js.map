            \"魅力\": 2,\n            \"智慧\": 2,\n            \"男性\": 1,\n            \"社交\": 2,\n            \"纯色材质\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [\n            \"武器\",\n            \"服装\",\n            \"饰品\"\n        ],\n        \"is_only\": 1\n    },\n    \"2000117\": {\n        \"id\": 2000117,\n        \"name\": \"乌萨麦\",\n        \"title\": \"未启用\",\n        \"text\": \"他之前在黑街打拳赌博，不过现在他觉得你正在玩的游戏更刺激。\",\n        \"pops\": [],\n        \"card_favour\": \"黑街拳师\",\n        \"type\": \"char\",\n        \"tips\": \"\",\n        \"rare\": 2,\n        \"resource\": \"cards/2000117\",\n        \"tag\": {\n            \"体魄\": 5,\n            \"魅力\": 1,\n            \"智慧\": 1,\n            \"战斗\": 5,\n            \"男性\": 1,\n            \"社交\": 1,\n            \"黑街居民\": 1,\n            \"身价\": 5,\n            \"纯色材质\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [\n            \"饰品\",\n            \"饰品\",\n            \"饰品\"\n        ],\n        \"is_only\": 1\n    },\n    \"2000118\": {\n        \"id\": 2000118,\n        \"name\": \"努尔\",\n        \"title\": \"未启用\",\n        \"text\": \"她的头发是红铜的颜色，而她的目光灼热，会烫伤你的胸膛，随后哈哈大笑，在周围带出点点火星。\",\n        \"pops\": [],\n        \"card_favour\": \"火法师\",\n        \"type\": \"char\",\n        \"tips\": \"\",\n        \"rare\": 2,\n        \"resource\": \"cards/2000118\",\n        \"tag\": {\n            \"体魄\": 1,\n            \"魅力\": 5,\n            \"智慧\": 1,\n            \"魔力\": 3,\n            \"女性\": 1,\n            \"战斗\": 3,\n            \"黑街居民\": 1,\n            \"身价\": 9,\n            \"纯色材质\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [\n            \"武器\",\n            \"服装\",\n            \"饰品\"\n        ],\n        \"is_only\": 1\n    },\n    \"2000119\": {\n        \"id\": 2000119,\n        \"name\": \"冒险者队长\",\n        \"title\": \"未启用\",\n        \"text\": \"只