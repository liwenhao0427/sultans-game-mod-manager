module.exports = "{\n    \"id\": 9321056,\n    \"text\": \"娇俏的访客\",     \n    \"is_replay\": 0, //是否可以重复触发\n    \"auto_start\": false,\n    \"start_trigger\": true, // 是否启动就立即开始校验条件\n    \"on\":{   //时机\n        \"round_begin_ba\":1\n    },\n    \"condition\":{  //条件\n        \n    },\n    \"settlement\": [    //效果 \n        {\n            \"tips_resource\":\"\", \n            \"tips_text\":\"\",\n            \"action\":\n\t\t\t{\n                //\"rite\":9008051, //娇俏的访客\n\t\t\t\t\"option\": \n\t\t\t\t{\n                \"id\":\"9321056_option_1\",\n                \"text\": \"阿鲁米娜小姐又又又来了，看来那个寒冷的雪夜已经过去，这段时间的磨砺总算是让这位大小姐有了些真正骄傲的资本。\\n在哲瓦德的魔法般的运作下，璀璨的珠宝们也得以和它们的小姐重逢。\\n奇怪的是，这次的会面也让你有些不知所措，难不成是被哲瓦德传染了？你始终不敢直视阿鲁米娜纯净的大眼睛，然而，在发现对方同样有些手足无措之后，你反倒大胆了许多。再细看之下，她那张宜喜宜嗔的小脸上还多了两抹少女的红晕，有着说不出的娇俏。\\n阿鲁米娜闪电般地瞄了你一眼，又难为情地低下头去，像是对着你的脚趾发问：“你……你说我是不是比以前成……成熟了？”\",\n                \"icon\":\"cards/2000774\",\n                \"items\": \n\t\t\t\t[\n                    {\n                        \"text\": \"你指的是哪方面？\",\n                        \"tag\": \"op1\"\n                    },\n                    {\n                        \"text\": \"诚恳地夸赞\",\n                        \"tag\": \"op2\"\n                    }\n                ]\n\t\t\t\t},\n\t\t\t\t\"case:op1\":\n\t\t\t\t{\n\t\t\t\t\t\"option\": \n\t\t\t\t\t{\n\t\t\t\t\t\"id\":\"9321056_option_2\",\n                    \"text\": \"在察觉到你不怀好意的目光之后，又联想到过往恋爱咨询、花园密谈的种种，阿鲁米娜小姐娇俏的小脸红得更甚，然而，在你还没来得及仔细欣赏这份少女的青涩的时候……\\n“停手！快停手！”你惨烈的哀嚎把院子里的仆人吓得不轻，但一想到是那位阿鲁米娜小姐到访，大家又都只是相视而笑。\\n说实话，你从没想到过哲瓦德家的小珍珠还会咬人。话说，这种时候或许更应该喊“住嘴”不是？\\n一番恶斗之后，你总算是暂时摆脱了这只会挠人的镇宅猫，当然，更可能是因为阿鲁米娜小姐已经累的气喘吁吁，话都说不利索了。\\n“你……你……果然我没有看错，你就是一个大淫贼，我死也不会嫁给你的！”\",\n                    \"icon\":\"cards/2000774\",\n                    \"items\": \n\t\t\t\t\t[\n                        {\n                            \"text\": \"你真的不嫁？\",\n                            \"tag\": \"op3\"\n                        }\n                    ]\n\t\t\t\t\t},\n\t\t\t\t\t\"case:op3\": \n\t\t\t\t\t{\n\t\t\t\t\t\"option\": {\n                    \"id\":\"9321056_option_3\",\n                    \"text\": \"你叹了口气：“你真的不嫁？”\\n“不嫁！”\\n“决心不嫁？”\\n“死也不嫁！”\\n你长舒一口气：“多谢多谢，感激不尽！”\\n“你谢我干什么？”阿鲁米娜小姐瞪圆了双眼。\\n“我不但要谢你，我还要谢天谢地！”\\n“你这人什么毛病！”\\n“我这人别的毛病倒也没有，就是有点疑心病。”\\n“疑心什么？”阿鲁米娜小姐的眼睛瞪得更圆了。\\n\",\n                    \"icon\":\"cards/2000774\",\n                    \"items\": \n\t\t\t\t\t\t[\n                        {\n                            \"text\": \"我总疑心别人想要我嫁给他，所以一直怕得要命！\",\n                            \"tag\": \"op4\"\n                        }\n\t\t\t\t\t\t]\n\t\t\t\t\t},\n\t\t\t\t\t\"case:op4\": {\n\t\t\t\t\t\t\t\"prompt\": {\n                        \"id\":\"9321056_prompt_4\",\n                        \"text\": \"“我总疑心别人想要我嫁给他，所以一直怕得要命！”你眨了眨眼睛。\\n这次引发的恶斗甚至惊动了远在卧房的梅姬，看着你鲜血淋漓的手臂，她一脸认真地问你是否考虑截肢。\\n你苦笑着摇了摇头，说到：“真见鬼，这姑娘值得一张征服卡，我说的。”\\n不出所料，你被她俩同时瞪了。\\n看在另一条胳膊的份上，你识趣地闭上了嘴。\\n看你消停了，于是梅姬像是拽走一只布娃娃那样把阿鲁米娜从你身边带走了，她们的声音消失在了走廊后面——特别是阿鲁米娜小姐的尖叫声。\\n最后不论梅姬做了什么，反正这姑娘回来的时候，身上又添了不少珠宝首饰，胸前还抱着几本梅姬送她的书，安静得像个真正的布娃娃。\\n见到你还在会客厅，她就又狠狠地瞪了你一眼，仿佛竹筒倒豆子般地说道：“我这次来就是为了告诉你我阿鲁米娜已经长大了不要再把我当成一个小孩子梅姬姐姐她们能做的我都能做！”\\n看着你一脸“这小姑娘又在说什么怪话呢”的表情，阿鲁米娜更急了：“总之……总之我今后会跟着你的！免……免得你又去淫……淫人妻女！”\\n最后的几个字显然已经超出了阿鲁米娜羞耻心所能承受的极限，她的脸红得仿佛能滴出血来。\\n于是，就如你们第一次见面那般——她像兔子一样地跑掉了。\",\n                        \"icon\":\"cards/2000774\"\n\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\"card\":[2000774,\"追随者+1\",\"激情+1\"],\n\t\t\t\t\t\t\t\"card\":[2000790,\"已拥有+1\"],\n\t\t\t\t\t\t\t\"card\":[2000776,\"已拥有+1\"],\n\t\t\t\t\t\t\t\"card\":[9000287,\"已拥有+1\"]\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\n\t\t\t\t\t}\n\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t},\n\t\t\t\"case:op2\":\n\t\t\t{\n\t\t\t\t\"option\": \n\t\t\t\t{\n                    \"id\":\"9321056_option_5\",\n                    \"text\": \"“嗯……”你冷静下来，认真地回忆了这段时间和阿鲁米娜相处的种种，诚恳地说道：“是的，阿鲁米娜，就像沙粒在蚌肉中生长，是苦痛造就了珍珠的坚硬、瑰丽与光彩夺目。”\\n阿鲁米娜的俏脸瞬间变得通红：“你……你又在骗我了！”\\n“刚才的话要是有一点假，叫我不得好……”“死”字还没说出口，阿鲁米娜已掩住了你的嘴，细若蚊咛地让你住嘴。\\n阿鲁米娜至今的人生分为两个阶段，在从未有人敢忤逆她的时候，你却从未给她留过情面，甚至敢一次次地“欺辱”她；而到了所有人都轻贱她、看低她的时候，你却说出了第一句真心的夸赞。\\n深埋的情愫不断涌动，懵懂的爱恋正在萌芽……\",\n                    \"icon\":\"cards/2000774\",\n                    \"items\": [\n                        {\n                            \"text\": \"还等什么！亲她！\",\n                            \"tag\": \"op6\"\n                        }\n                    ]\n                },\n\t\t\t\t\"case:op6\": {\n\t\t\t\t\t\"option\": \n\t\t\t\t\t{\n                    \"id\":\"9321056_option_6\",\n                    \"text\": \"正当你们逐渐四目相对，情欲渐长的时候……阿鲁米娜小姐用力地一把将你推开了，喘着粗气说道：“你……你……果然是为了欺负我才这么说的，你就是一个大淫贼！我死也不会嫁给你的！”\\n行吧。你叹了口气：“你真的不嫁？”\\n“不嫁！”\\n“决心不嫁？”\\n“死也不嫁！”\\n你长舒一口气：“多谢多谢，感激不尽！”\\n“你谢我干什么？”阿鲁米娜小姐瞪圆了双眼。\\n“我不但要谢你，我还要谢天谢地！”\\n“你这人什么毛病！”\\n“我这人别的毛病倒也没有，就是有点疑心病。”\\n“疑心什么？”阿鲁米娜小姐的眼睛瞪得更圆了。\\n\",\n                    \"icon\":\"cards/2000774\",\n                    \"items\": [\n                        {\n                            \"text\": \"我总疑心别人想要我嫁给他，所以一直怕得要命！\",\n                            \"tag\": \"op7\"\n                        }\n                    ]\n\t\t\t\t\t},\n\t\t\t\t\t\"case:op7\": {\n\t\t\t\t\t\t\t\"prompt\": {\n                        \"id\":\"9321056_prompt_7\",\n                        \"text\": \"“我总疑心别人想要我嫁给他，所以一直怕得要命！”你眨了眨眼睛。\\n下一秒，“停手！快停手！”你惨烈的哀嚎把院子里的仆人吓得不轻，但一想到是那位阿鲁米娜小姐到访，大家又都只是笑而不语。\\n说实话，你从没想到过哲瓦德家的小珍珠还会咬人。话说，这种时候或许更应该喊“住嘴”不是？\\n这番恶斗甚至惊动了远在卧房的梅姬，看着你鲜血淋漓的手臂，她一脸认真地问你是否考虑截肢。\\n你苦笑着摇了摇头，说到：“真见鬼，这姑娘值得一张征服卡，我说的。”\\n不出所料，你被她俩同时瞪了。\\n看在另一条胳膊的份上，你识趣地闭上了嘴。\\n看你消停了，于是梅姬像是拽走一只布娃娃那样把阿鲁米娜从你身边带走了，她们的声音消失在了走廊后面——特别是阿鲁米娜小姐的尖叫声。\\n最后不论梅姬做了什么，反正这姑娘回来的时候，身上又添了不少珠宝首饰，胸前还抱着几本梅姬送她的书，安静得像个真正的布娃娃。\\n见到你还在会客厅，她就又狠狠地瞪了你一眼，仿佛竹筒倒豆子般地说道：“我这次来就是为了告诉你我阿鲁米娜已经长大了不要再把我当成一个小孩子梅姬姐姐她们能做的我都能做！”\\n看着你一脸“这小姑娘又在说什么怪话呢”的表情，阿鲁米娜更急了：“总之……总之我今后会跟着你的！免……免得你又去淫……淫人妻女！”\\n最后的几个字显然已经超出了阿鲁米娜羞耻心所能承受的极限，她的脸红得仿佛能滴出血来\\n于是，就如你们第一次见面那般——她像兔子一样地跑掉了。\",\n                        \"icon\":\"cards/2000774\"\n\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\"card\":[2000774,\"追随者+1\",\"激情+1\"],\n\t\t\t\t\t\t\t\"card\":[2000790,\"已拥有+1\"],\n\t\t\t\t\t\t\t\"card\":[2000776,\"已拥有+1\"],\n\t\t\t\t\t\t\t\"card\":[9000287,\"已拥有+1\"]\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\n\t\t\t\t}\n\t\t\t\t\t\n            }\n            }\n        }\n\n    ]\n}";