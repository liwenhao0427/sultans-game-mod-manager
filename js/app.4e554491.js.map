module.exports = " {\n        \"id\": 5002031,\n        \"name\": \"师出有名\",\n        \"text\": \"你在朝堂上向苏丹请求出征的时候，满朝哗然。群臣们无一不反对你大动干戈地挑起内乱，只是为了偏袒一个妓女。\\n可你知道，苏丹会答应。他不喜欢那个随着年岁渐长而渐妄自尊大的领主，更何况，为了一个女人，杀死她父亲，这是多么有趣的事情。\\n果然，你看到苏丹脸上露出兴致盎然的笑容：“他过去可是我最有力的左膀右臂呢，[player.name]卿。如果你能拿出一张征服卡，我便允许你出兵。”\",       \n        \"tips\": \"\",\n        \"once_new\":0,\n        \"round_number\": 3,\n        \"waiting_round\":20,\n        \"waiting_round_end_action\":[\n            {\n                \"condition\": {   //特殊结果1：你没有参加\n                },\n                \"result_title\":\"\",\n                \"result_text\": \"你在戏弄伟大的苏丹么？你会为此付出代价的。\",\n                \"result\": \n                {\n                },\n                \"action\": {\n                    \"over\":1\n                }\n            }\n        ],\n        \"method_settlement\": \"\",\n        \"auto_begin\": 0,\n        \"auto_result\":0,\n        \"location\": \"野外:[1,6]\",\n        \"icon\": \"rite_11\",  \n        \"tag_tips\": [\n            \"体魄\",\n            \"战斗\"\n        ],\n        \"tag_tips_up\":{\n            \"tips\":[\"战斗\",\"体魄\"],\n            \"type\":\"fight_result\"\n        },\n        \"tips_text\":[\n            \"需要征服卡才能发动这场仪式\",\n            \"这将是非常艰难的战斗，确保你已经准备好\",\n            \"战事凶险，如非必要不要亲自上阵\",\n            \"这次征讨将持续3天\"\n        ],\n        \"open_conditions\": [\n        ],\n        \"random_text\": {        \n        },\n        \"random_text_up\":{\n            \"r1\":{\n                \"text\":\"战斗开始了\",\n                \"type\":\"fight_result\",\n                \"type_tips\":\"你的战斗和体魄获得的骰子数，将受敌方战斗和体魄的影响。\",\n                \"low_target\": 3,\n                \"low_target_tips\": \"你至少需要3点成功才能征讨成功。\"\n            }\n        },\n        \"random_effect\": {          \n        },\n        \"settlement_prior\": [\n        ],                \n        \"settlement\": [\n            {\n                \"condition\": {   //你的回合\n                    \"r1:战斗+体魄-e(战斗+体魄)>=\":[3,5]