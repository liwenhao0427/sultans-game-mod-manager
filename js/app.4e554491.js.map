module.exports = "{\n    \"id\": 5008030,\n    \"name\": \"气急败坏\",\n    \"text\": \"哲瓦德气势汹汹地来找你，要求跟你决斗。他说你侮辱了他的女儿。当然，一般人这种时候都会生气的，不过一般人会说，我要亲手杀了你，而哲瓦德的表达就是……他雇了黑街最贵的角斗士——这事儿应该还有一些商量的余地。\",       \n    \"tips\": \"\",\n    \"mapping_id\":8001103,  \n    \"once_new\":0,\n    \"round_number\": 1,\n    \"waiting_round\":3,\n    \"waiting_round_end_action\":[\n        {\n            \"condition\":\n            {\n                \n            },\n            \"result_title\":\"\",\n            \"result_text\": \"\",\n            \"result\": \n            {   \n\n            },\n            \"action\":\n            {\n                \"event_on\":5321042,        //决斗幕后\n                \"prompt\": {\n                    \"id\": \"prompt_5008030_01\",\n                    \"text\": \"你没有及时劝说哲瓦德……这当然也算是一种表态。\",\n                    \"icon\":\"cards/2000057\"\n                }\n            }\n        }\n    ],\n    \"method_settlement\": \"\",\n    \"auto_begin\": 0,\n    \"auto_result\":0,\n    \"location\": \"自宅:[2,12]\", \n    \"icon\": \"rite_20\", \n    \"tag_tips\": [\n    ],\n    \"tag_tips_up\":{\n        \"tips\":[\"智慧\",\"魅力\"],\n        \"type\":\"normal_result\"\n    },\n    \"tips_text\":[\n        \"哲瓦德很生气，最好劝说一下他。\"\n       \n    ],\n    \"open_conditions\": [\n        {\n            \"condition\": {\n                \"any\":{\n                    \"s2\":1,\n                    \"s3\":1\n                }\n            },\n            \"tips\": \"需要表明对哲瓦德的态度。\"\n        }\n\n    \n    ],\n    \"random_text\":{\n    },\n    \"random_text_up\":{\n        \"r1\":{\n            \"text\":\"需要过智慧和魅力的检定来劝说哲瓦德。\",\n            \"type\":\"normal_result\",\n            \"type_tips\":\"你的智慧和魅力为你提供了完整的骰子数量。\",\n            \"low_target\": 3,\n            \"low_target_tips\": \"你至少需要3点成功才能获得胜利。\"\n        }\n    },\n    \"settlement_prior\": [\n    \n    ],                \n    \"settlement\": [\n        {\n            \"condition\":\n            {\n                \"s4\":1,     //展示面纱\n\t\t\t\t\"!s2\":1\n            },\n            \"result_title\":\"她好香啊\",\n            \"result_text\": \"当哲瓦德气势汹汹地走到你面前时，发现你手上就拿着自己女儿的面纱——全城也就他会给女儿买这么奢侈，又这么俗气的玩意儿……\\n别生气嘛，哲瓦德老兄，阿鲁米娜小姐可是给我们留下了定情信物呢。你一边说，一边把这片发光的丝绸凑到鼻子前面……\\n他本来就气在头上，被你这么一激，更是气得假发迸脱，面目都要裂开来……盛怒之下，甚至拔不出自己的宝刀，就这么硬生生把刀鞘从腰带上扯了下来，要打你个狗血淋头……\\n可惜，你还没来得及逃跑，他就这么原地僵住，捂着自己的胸口，痛苦地抽搐、喘息，活生生气死了过去。\",\n            \"result\": \n            {     \n                \"clean.s1\":1,\n                \"counter+7100002\":1 //恶名+1\n            },\n            \"action\":\n            {\n                \"delay\": {        //延迟1回合执行\n                \"id\":50080301,\n                \"round\": 1,\n                \"prompt\":{       \n                    \"id\":\"prompt_5008030_02\",\n                    \"text\":\"哲瓦德意外死亡后，他的敌人们像秃鹫一样分割了他的财产、头衔、生意，以及妻女——更可恶的是，苏丹甚至说是他自己死的，不让你折断一张杀戮卡！\"\n                }\n            }\n        }\n        },\n        {\n            \"condition\":\n            {\n                \"!s4\":1,     //没有放置面纱\n                \"s2\":1,     //尝试劝说\n                \"r1:智慧+魅力>=\":[3,5]    //成功\n            },\n            \"result_title\":\"我就是逗逗她\",\n            \"result_text\": \"你花言巧语地劝他，说自己只是觉得阿鲁米娜小姐过于天真无邪了，所以想教会她“男人没有好东西”。\\n哲瓦德半信半疑地沉吟半晌，而后，他要你指着太阳发誓，绝不会染指阿鲁米娜小姐。\\n你发了誓，他满意地走了。\\n这件事传开了，稍微影响了你的口碑。\",\n            \"result\": \n            {     \n                \"counter+7100002\":1 //恶名+1\n            },\n            \"action\":\n            {\n            }\n        },\n\t\t\n\t\t{\n            \"condition\":\n            {\n                \"s4\":1,     //放置面纱\n                \"s2\":1,     //尝试劝说\n                \"r1:智慧+魅力>=\":[6,5]    //成功\n            },\n            \"result_title\":\"我就是逗逗她\",\n            \"result_text\":\"你花言巧语地劝他，说自己只是觉得阿鲁米娜小姐过于天真无邪了，所以想教会她“男人没有好东西”。\\n至于这面纱，天可怜见，你总不能任由它落在地上无动于衷吧？就这样，你都挨了梅姬好一顿河东狮吼。实际上，有哲瓦德这样舐犊情深的父亲，又有谁敢觊觎他的珍宝呢？\\n你又说你一向深知哲瓦德最得阿鲁米娜小姐的信赖，由他将头纱收回、转交并代为解释是再合适不过了，至于原谅那更是万万不敢奢求。\\n哲瓦德沉吟半晌，狐疑的神色掩盖不住对你吹捧之词的受用。但即便如此，他依旧要你指着太阳发誓，绝不会染指阿鲁米娜小姐。\\n你甚至对苏丹王冠上的月长石都发了誓，他才满意地走了。\\n这件事传开了，稍微影响了你的口碑。\",\n            \"result\": \n            {     \n                \"clean.s4\":1,\n\t\t\t\t\"counter+7100002\":1 //恶名+1\n            },\n            \"action\":\n            {\n\t\t\t\t\"delay\": {      //延迟2回合执行\n                    \"id\":50080309,\n                    \"round\": 2,\n                    \"event_on\":9321052    //恋爱咨询2\n                }\n            }\n        },\n        {\n            \"condition\":\n            {\n                \"!s4\":1,        //没有放置面纱\n                \"s2\":1,       //尝试劝说\n                \"r1:智慧+魅力<\":[3,5]  //尝失败\n            },\n            \"result_title\":\"是她先……\",\n            \"result_text\": \"显然，这是一次非常失败的说服，哲瓦德又加了双倍的钱，要确保当众把你的三条腿都彻底打断。\",\n            \"result\": \n            {     \n                \n            },\n            \"action\":\n            {\n                \"delay\": {        //延迟1回合执行\n                \"id\":50080302,\n                \"round\": 1,\n                \"event_on\":5321042,        //决斗幕后\n                \"prompt\":{       \n                    \"id\":\"prompt_5008030_03\",\n                    \"text\":\"哲瓦德带着斗士来找你决斗，遵循传统，你理应出面。\",\n                    \"icon\":\"cards/2000057\"\n                }\n            }\n            }\n        },\n\t\t{\n            \"condition\":\n            {\n                \"s4\":1,        //放置面纱\n                \"s2\":1,       //尝试劝说\n                \"r1:智慧+魅力<\":[6,5]  //尝失败\n            },\n            \"result_title\":\"是她先……\",\n            \"result_text\":\"显然，这是一次非常失败的说服，哲瓦德又加了双倍的钱，要确保当众把你的三条腿都彻底打断。\",\n            \"result\": \n            {     \n                \n            },\n            \"action\":\n            {\n                \"delay\": {        //延迟1回合执行\n                \"id\":50080304,\n                \"round\": 1,\n                \"event_on\":5321042,        //决斗幕后\n                \"prompt\":{       \n                    \"id\":\"prompt_5008030_05\",\n                    \"t