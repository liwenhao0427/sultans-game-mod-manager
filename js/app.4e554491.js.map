sh\": {},\n        \"equips\": [],\n        \"is_only\": 0\n    },\n    \"2000865\": {\n        \"id\": 2000865,\n        \"name\": \"灵视的遮掩\",\n        \"title\": \"特殊\",\n        \"text\": \"你的灵视为你在准备逃跑时提供的掩护。\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"item\",\n        \"tips\": \"\",\n        \"rare\": 1,\n        \"resource\": \"cards/2000862\",\n        \"tag\": {\n            \"灵视的遮掩\": 1,\n            \"已拥有\": 1,\n            \"可堆叠\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [],\n        \"is_only\": 0\n    },\n    \"2000866\": {\n        \"id\": 2000866,\n        \"name\": \"被打包的财物\",\n        \"title\": \"特殊\",\n        \"text\": \"你的财富，你在异国他乡可以切实依赖的东西。\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"item\",\n        \"tips\": \"\",\n        \"rare\": 2,\n        \"resource\": \"cards/2000667\",\n        \"tag\": {\n            \"已拥有\": 1,\n            \"可堆叠\": 1,\n            \"纯色材质\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [],\n        \"is_only\": 1\n    },\n    \"2000867\": {\n        \"id\": 2000867,\n        \"name\": \"贫民区的孤儿\",\n        \"title\": \"孤儿\",\n        \"text\": \"奈费勒带来的孤儿们，承载着未来和希望。\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"item\",\n        \"tips\": \"\",\n        \"rare\": 1,\n        \"resource\": \"cards/2000887\",\n        \"tag\": {\n            \"体魄\": 1,\n            \"孤儿\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [],\n        \"is_only\": 0\n    },\n    \"2000868\": {\n        \"id\": 2000868,\n        \"name\": \"慈爱\",\n        \"title\": \"美德\",\n        \"text\": \"一直到很多很多年之后，这里的孩子们都长大成人，他们也会去用梅姬的方法拥抱自己的亲人，爱人，朋友……当生命中出现苦难时，他们总是会回忆起梅姬是怎么做的。\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"item\",\n        \"tips\": \"\",\n        \"rare\": 4,\n        \"resource\": \"cards/2000868\",\n        \"tag\": {\n            \"爱\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [],\n        \"is_only\": 0\n    },\n    \"2000869\": {\n        \"id\": 2000869,\n        \"name\": \"对等\",\n        \"title\": \"美德\",\n        \"text\": \"法里斯不会照顾小孩，但他教小孩照顾流浪狗——直到小狗长大了又生了小狗，直到老狗去世……这是很公平的，人照顾宠物，宠物教会了人一生的样子。\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"item\",\n        \"tips\": \"\",\n        \"rare\": 4,\n        \"resource\": \"cards/2000869\",\n        \"tag\": {\n            \"爱\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [],\n        \"is_only\": 0\n    },\n    \"2000870\": {\n        \"id\": 2000870,\n        \"name\": \"自我\",\n        \"title\": \"美德\",\n        \"text\": \"贾丽拉反反复复地告诫孩子们，做自己的主人，永远不要把自己交给其他人……这有点极端了，大部分孩子后来都找到了其他爱人……嗯，其中极少数，一直牢记了她的话，他们后来成就了一些事业。\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"item\",\n        \"tips\": \"\",\n        \"rare\": 4,\n        \"resource\": \"cards/2000870\",\n        \"tag\": {\n            \"爱\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [],\n        \"is_only\": 0\n    },\n    \"2000871\": {\n        \"id\": 2000871,\n        \"name\": \"理想\",\n        \"title\": \"美德\",\n        \"text\": \"理想是易碎的。大部分孩子不够幸运，不够强大，直到最后也没有达到理想的山巅。但这些平凡之人喝酒的时候也会想起阿迪莱老师的话，这些话语重塑了他们的人生，让他们看到了完全不同的风景——哪怕只是山腰的风景。\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"item\",\n        \"tips\": \"\",\n        \"rare\": 4,\n        \"resource\": \"cards/2000871\",\n        \"tag\": {\n            \"信\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [],\n        \"is_only\": 0\n    },\n    \"2000872\": {\n        \"id\": 2000872,\n        \"name\": \"领袖\",\n        \"title\": \"美德\",\n        \"text\": \"偶像崇拜的方式有很多种，有些人一直在追寻偶像，有些人试图成为偶像，有些人则致力于崇拜你——他们最初，最伟大的恩人。\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"item\",\n        \"tips\": \"\",\n        \"rare\": 4,\n        \"resource\": \"cards/2000872\",\n        \"tag\": {\n            \"信\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [],\n        \"is_only\": 0\n    },\n    \"2000873\": {\n        \"id\": 2000873,\n        \"name\": \"知识\",\n        \"title\": \"美德\",\n        \"text\": \"大部分人都做不到真正相信知识——更不要说去运用和实践了。能够通过理性与意志力去认知世界，改造世界的都是天才与伟人……但这里的孩子中，居然半数都有着这样的资质，也许是鲁梅拉无形中影响了他们吧？\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"item\",\n        \"tips\": \"\",\n        \"rare\": 4,\n        \"resource\": \"cards/2000873\",\n        \"tag\": {\n            \"信\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [],\n        \"is_only\": 0\n    },\n    \"2000874\": {\n        \"id\": 2000874,\n        \"name\": \"体验\",\n        \"title\": \"美德\",\n        \"text\": \"据说，夏玛后来捐了很多很多钱，帮助这里的孩子成就事业——他们也继承了夏玛的品位与智慧，至少一部分。\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"item\",\n        \"tips\": \"\",\n        \"rare\": 4,\n        \"resource\": \"cards/2000874\",\n        \"tag\": {\n            \"智\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [],\n        \"is_only\": 0\n    },\n    \"2000875\": {\n        \"id\": 2000875,\n        \"name\": \"得利\",\n        \"title\": \"美德\",\n        \"text\": \"无论如何努力，从这里出身的孩子，大部分都没法像哲瓦德那么富有……但他们也不太会有哲瓦德那么坏，不是么？至少他们中的少数人富起来之后，也做了一些好事。\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"item\",\n        \"tips\": \"\",\n        \"rare\": 4,\n        \"resource\": \"cards/2000875\",\n        \"tag\": {\n            \"智\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [],\n        \"is_only\": 0\n    },\n    \"2000876\": {\n        \"id\": 2000876,\n        \"name\": \"调和\",\n        \"title\": \"美德\",\n        \"text\": \"有多少人能明白做人的火候和放盐的分寸？又有多少人有机会用烹饪海鲜的方式来治理一个国家？但有一点是真的，就是学会了哈比卜厨艺的孩子之后都找到了很棒的人生伴侣。\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"item\",\n        \"tips\": \"\",\n        \"rare\": 4,\n        \"resource\": \"cards/2000876\",\n        \"tag\": {\n            \"智\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [],\n        \"is_only\": 0\n    },\n    \"2000877\": {\n        \"id\": 2000877,\n        \"name\": \"宽容\",\n        \"title\": \"美德\",\n        \"text\": \"奈费勒这个不要脸的东西，他自己战天斗地，对谁都是一副臭脸，居然好意思给小朋友们讲宽容！？\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"item\",\n        \"tips\": \"\",\n        \"rare\": 4,\n        \"resource\": \"cards/2000877\",\n        \"tag\": {\n            \"力\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [],\n        \"is_only\": 0\n    },\n    \"2000878\": {\n        \"id\": 2000878,\n        \"name\": \"浪漫\",\n        \"title\": \"美德\",\n        \"text\": \"奈布哈尼只说对了一半。因为每个人的故事，每个人心中的浪漫……都是不一样的。但这些孩子中，确实有人实践了自己心中的浪漫，将人生谱写为不输给他的经典传奇。\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"item\",\n        \"tips\": \"\",\n        \"rare\": 4,\n        \"resource\": \"cards/2000878\",\n        \"tag\": {\n            \"力\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [],\n        \"is_only\": 0\n    },\n    \"2000879\": {\n        \"id\": 2000879,\n        \"name\": \"欲望\",\n        \"title\": \"美德\",\n        \"text\": \"真不该让娜依拉来教坏小孩子，但她说对了一点，我们不能像奴仆一样饲养这些孩子，需要让他们看到更上层的世界——哪怕这是一种痛苦，也需要（奈费勒如此说道）\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"item\",\n        \"tips\": \"\",\n        \"rare\": 4,\n        \"resource\": \"cards/2000879\",\n        \"tag\": {