name\": \"拷问工具\",\n        \"title\": \"未启用\",\n        \"text\": \"拷问工具\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"item\",\n        \"tips\": \"\",\n        \"rare\": 2,\n        \"resource\": \"cards/2000077\",\n        \"tag\": {\n            \"纯色材质\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [],\n        \"is_only\": 1\n    },\n    \"2000080\": {\n        \"id\": 2000080,\n        \"name\": \"朱娜\",\n        \"title\": \"受欢迎的妓女\",\n        \"text\": \"朱娜是美丽的，但不够高贵。这影响了她的身价，却对很多人来说正好合适。其他妓女会认为她浪费了自己的天赋，但没人知道她到底想要什么。\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"char\",\n        \"tips\": \"\",\n        \"rare\": 1,\n        \"resource\": \"cards/2000080\",\n        \"tag\": {\n            \"体魄\": 2,\n            \"魅力\": 3,\n            \"女性\": 1,\n            \"妓女\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [\n            \"武器\",\n            \"服装\",\n            \"饰品\"\n        ],\n        \"is_only\": 1\n    },\n    \"2000081\": {\n        \"id\": 2000081,\n        \"name\": \"贾丽拉\",\n        \"title\": \"皮鞭女王\",\n        \"text\": \"贾丽拉一直在塑造自己高不可攀的人设。很多客户在她身上花掉的金币足以买下几座农庄，也只能跪着亲她的脚指头——也许他们需要的就是这个。\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"char\",\n        \"tips\": \"\",\n        \"rare\": 2,\n        \"resource\": \"cards/2000081\",\n        \"tag\": {\n            \"体魄\": 3,\n            \"魅力\": 3,\n            \"智慧\": 2,\n            \"女性\": 1,\n            \"社交\": 1,\n            \"妓女\": 1,\n            \"纯色材质\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [\n            \"武器\",\n            \"服装\",\n            \"饰品\"\n        ],\n        \"is_only\": 1\n    },\n    \"2000082\": {\n        \"id\": 2000082,\n        \"name\": \"夏玛\",\n        \"title\": \"交际花\",\n        \"text\": \"有人说夏玛是某个大贵族的私生女，而她高贵的谈吐也间接证实了这种说法。当很多上不得台面的事情需要疏通的时候，她可能是城里最好的掮客，而床笫之欢不过是这种服务中提供的一点糖果。\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"char\",\n        \"tips\": \"\",\n        \"rare\": 3,\n        \"resource\": \"cards/2000082\",\n        \"tag\": {\n            \"体魄\": 2,\n            \"魅力\": 5,\n            \"智慧\": 3,\n            \"女性\": 1,\n            \"社交\": 5,\n            \"战斗\": 1,\n            \"妓女\": 1,\n            \"男性\": 1,\n            \"爱书人\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [\n            \"武器\",\n            \"服装\",\n            \"饰品\"\n        ],\n        \"is_only\": 1\n    },\n    \"2000083\": {\n        \"id\": 2000083,\n        \"name\": \"妻子的不满\",\n        \"title\": \"不满\",\n        \"text\": \"妻子在记恨你了……当然，这并不奇怪，瞧瞧你都干了些什么事情。这些积累的不满会给你带来厄运。\",\n        \"pops\": [],\n        \"card_favour\": \"尽管已经有了心理准备，你会因为苏丹的残酷游戏做出很多难以想象的事情来，而这都是为了活下去。但有些事情仍然会如同毒药一般腐蚀最爱你的心灵。【妻子的不满会带来负面事件惩罚你，同时在对应的检定中会降低你的社交与魅力数值。】\",\n        \"type\": \"item\",\n        \"tips\": \"\",\n        \"rare\": 2,\n        \"resource\": \"cards/2000083\",\n        \"tag\": {\n            \"不满\": 1,\n            \"已拥有\": 1,\n            \"可堆叠\": 1,\n            \"社交\": -1,\n            \"魅力\": -1,\n            \"纯色材质\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [],\n        \"is_only\": 0\n    },\n    \"2000091\": {\n        \"id\": 2000091,\n        \"name\": \"宴会级餐饮\",\n        \"title\": \"未启用\",\n        \"text\": \"宴会餐饮\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"item\",\n        \"tips\": \"\",\n        \"rare\": 3,\n        \"resource\": \"cards/2000091\",\n        \"tag\": {\n            \"食物\": 1,\n            \"已拥有\": 1,\n            \"纯色材质\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [],\n        \"is_only\": 0\n    },\n    \"2000092\": {\n        \"id\": 2000092,\n        \"name\": \"恶名\",\n        \"title\": \"未启用\",\n        \"text\": \"有些是你做过的，有些是人们认为你做过的。但肯定都比实际发生的更糟糕。这些积累的不满会给你带来厄运。\",\n        \"pops\": [],\n        \"card_favour\": \"大部分时候，人们不敢去恨他们的统治者，于是他们选择恨你，仿佛你才是这一切灾难的根源。【积累的恶名会带来负面事件惩罚你，同时在对应的检定中会降低你的社交数值。】\",\n        \"type\": \"item\",\n        \"tips\": \"\",\n        \"rare\": 2,\n        \"resource\": \"cards/2000092\",\n        \"tag\": {\n            \"恶名\": 1,\n            \"已拥有\": 1,\n            \"可堆叠\": 1,\n            \"社交\": -1,\n            \"纯色材质\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [],\n        \"is_only\": 0\n    },\n    \"2000098\": {\n        \"id\": 2000098,\n        \"name\": \"受伤\",\n        \"title\": \"状态\",\n        \"text\": \"一道伤口，会降低你的身体属性。\",\n        \"pops\": [],\n        \"card_favour\": \"受伤与疾病会降低角色属性，同时他们还可能在【疾病发作】事件中死亡。\",\n        \"type\": \"item\",\n        \"tips\": \"\",\n        \"rare\": 2,\n        \"resource\": \"cards/2000098\",\n        \"tag\": {\n            \"受伤\": 1,\n            \"体魄\": -1,\n            \"魅力\": -1,\n            \"战斗\": -1,\n            \"生存\": -1,\n            \"隐匿\": -1,\n            \"纯色材质\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [],\n        \"is_only\": 0\n    },\n    \"2000100\": {\n        \"id\": 2000100,\n        \"name\": \"对苏丹的恐惧\",\n        \"title\": \"思潮\",\n        \"text\": \"承认自己害怕苏丹是一件很有趣的事情，人人都应当敬畏自己的君主，但不能表现出来……除非，他已经过度疯狂，开始喜欢被人恐惧的滋味。直面这一点将是心生叛逆的开始。\",\n        \"pops\": [],\n        \"card_favour\": \"\",\n        \"type\": \"item\",\n        \"tips\": \"\",\n        \"rare\": 1,\n        \"resource\": \"cards/2000100\",\n        \"tag\": {\n            \"思潮\": 1,\n            \"已拥有\": 1,\n            \"可堆叠\": 1,\n            \"纯色材质\": 1\n        },\n        \"card_vanishing\": 0,\n        \"vanish\": {},\n        \"equips\": [],\n        \"is_only\": 1\n    },\n    \"2000111\": {\n        \"id\": 2000111,\n        \"n