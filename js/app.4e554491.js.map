module.exports = "{\n    \"id\": 9321052,\n    \"text\": \"恋爱咨询2 \",\n    \"is_replay\": 0, //是否可以重复触发\n    \"auto_start\": false, \n    \"start_trigger\": true, // 是否启动就立即开始校验条件\n    \"on\": { //时机\n         \"round_begin_ba\": 1\n    },\n    \"condition\": { //条件\n    \"all\":{\n        \"have.2000057\":1 //哲瓦德存活\n    }\n    },\n    \"settlement\": [ //效果 \n    {\n        \"tips_resource\":\"\", \n        \"tips_text\":\"\",\n        \"action\":{\n            \"option\": {\n                \"id\":\"9321052_option_1\",\n                \"text\": \"阿鲁米娜小姐突然又来了，她明晃晃地坐在你的客厅里，浑身璀璨的珠宝首饰，实在是让人想不注意到都难。\\n“我有一些问题，想问问不是我父亲的男性；这种男性里，有点儿地位的，我只认识你。”她望着你说，又略微红了红脸，“想必你这个恶徒已经尝过我父亲的教训了，所以这次最好放尊重点。”显然，没人敢纠正这位傲慢大小姐的礼貌问题，“你愿意回答吗？\",\n                \"icon\":\"cards/2000774\",\n                \"items\": [\n                    {\n                        \"text\": \"如果你改改你的语气——除非你还希望来一次所谓的“不尊重”\",\n                        \"tag\": \"op1\"\n                    },\n                    {\n                        \"text\": \"说吧\",\n                        \"tag\": \"op2\"\n                    }\n                ]\n            },\n            \"case:op1\": {\n                //\"rite\":5008047, //少女的欢宴\n                \"option\": {\n                    \"id\":\"9321052_prompt_1\",\n                    \"text\": \"你的话让她涨红了脸，看来，过去还真没人指出过她这种粗鲁的口气，当然，也没有人敢这样和她说话。\\n“我的语气……怎么了。我的语气——就是我的语气，就是很好啊！”\\n你忍住笑，只是一昧地欣赏她手足无措的样子，没有回答。\\n过了一会，她捏着衣角上的纯金铃铛，不情不愿地、小声说：“除了……嗯……除了我可能，可能应该用，用您字。”\\n虽然不算是有所改善，但这总也算是进步吧。\",\n                    \"icon\":\"cards/2000774\",\n                    \"items\": [\n                        {\n                            \"text\": \"说吧\",\n                            \"tag\": \"op3\"\n                        }\n                    ]\n                },\n                \"case:op3\": {\n                \"option\": {\n                    \"id\":\"9321052_option_2\",\n                    \"text\": \"她的问题很简单，“到底什么样的男人才值得嫁？”\\n在她列举的新郎备选中，你惊恐地发现，竟然连苏丹都在列……其他人选包括了首都里所有优质男青年，她理所应当地觉得这其中每个人自己都有希望，只看自己喜不喜欢。\\n你一边思考着她到底是如何被父亲娇宠到这个地步的，一边谨慎地提出了你的看法……\",\n                    \"icon\":\"cards/2000774\",\n                    \"items\": [\n                        {\n                            \"text\": \"勇武\",\n                            \"tag\": \"op4\"\n                        },\n                        {\n                            \"text\": \"智慧\",\n                            \"tag\": \"op5\"\n                        },\n                        {\n                            \"text\": \"权力\",\n                            \"tag\": \"op6\"\n                        },\n                        {\n                            \"text\": \"财力\",\n                            \"tag\": \"op7\"\n                        },\n                        {\n                            \"text\": \"幸福\",\n                            \"tag\": \"op12\"\n                        }\n                    ]\n                }\n                },\n                \"case:op4\": {\n                    \"prompt\": {\n                        \"id\":\"9321052_prompt_2\",\n                        \"text\": \"“强壮的男人！我喜欢！超级喜欢！”她喘着粗气，猛烈表达赞同，“我尤其喜欢那些漂亮的腿……男人就要跑得快才对，这样决斗的时候也不会被抓住杀死！”\\n你很想纠正一下她对于“决斗”这件事的定义……但是，算了，反正她现在也听不进去。\\n“但勇武的男人要去哪里找呢？嗯……练武场？那里都是些油腻的富家公子……难道要我上战场？”\\n她歪着头，稚气的头颅里难得地充满了和华贵衣料、精美首饰无关的事。过了一会，她用力甩了甩头。\\n“不管了——总之这个给你，咨询的报酬！”\",\n                        \"icon\":\"cards/2000774\"\n                    }\n                },\n                \"case:op5\": {\n                    \"prompt\": {\n                        \"id\":\"9321052_prompt_3\",\n                        \"text\": \"你告诉她，肌肉会衰老，金钱会散去，权势会反咬一口，只有智慧永远伴随着你。\\n“但是，聪明的男人们总会用聪明的办法去骗他们的女人，是吧？我爸爸就是这样骗了我妈妈……唔，但妈妈也过得很舒服、很富裕，唔……”\\n她似乎陷入了思考，那小小的、稚气的头颅里难得地装满了和珠宝首饰、华贵衣料无关的事。\\n“找个聪明的男人好像是不错，前提是他还要有钱，还要帅，还要让我有地位——这种男人一旦出现，就会引起腥风血雨呢！”\\n说完，她就津津有味地给你讲了一堆首都年轻贵族女孩圈的八卦，这可都是浴场里听不来的猛料。\",\n                        \"icon\":\"cards/2000774\"\n                    }\n                },\n                \"case:op6\": {\n                    \"prompt\": {\n                        \"id\":\"9321052_prompt_4\",\n                        \"text\": \"“哦，就像您一样，对吗？父亲说您不高兴的时候，苏丹就也不高兴，而您永远知道怎么让苏丹高兴！”\\n她边说着，边认真思考，孩子气的面庞难得地严肃。\\n“所以我应该找一个权臣，嗯……而且要一个强壮的、聪明的、英俊的……当一个人有权势的时候，他看起来就是比别人要英俊，比如说您，对吧？”\\n你告诉她这话你确实不知道怎么接。\\n她大笑起来，似乎觉得这个玩笑很有趣。在她离开时，还在笑着说关于你多么英俊和多么有权势的事，这让你变得更有名了。\",\n                        \"icon\":\"cards/2000774\"\n                    }\n                },\n                \"case:op7\": {\n                    \"prompt\": {\n                        \"id\":\"9321052_prompt_5\",\n                        \"text\": \"“这样的话，我应该嫁给我爸才对，他是我见过的最会搞钱的人，无论是什么手段。”\\n她望着你的表情，然后突然哈哈大笑起来。\\n“我开玩笑的——看你……看您的脸，您不会当真了吧！我才不嫁给父亲呢，他太胖了！”\\n而后，她像是在思考你的话，孩子气的面容上难得露出了几许严肃。\\n“会赚钱的男人是最好的男人，您说的或许没错；只要他会赚钱，那么无论是勇士、是谋士、还是大臣，都可以花钱买到……”\\n她跳起身，冲你行了个礼，又塞给你一件东西。\\n“这是咨询的报酬。”\",\n                        \"icon\":\"cards/2000774\"\n                    }\n                },\n\t\t\t\t\"case:op12\": {\n                    \"rite\":9008047,//少女的欢宴2\n\t\t\t\t\t\"prompt\": {\n                        \"id\":\"9321052_prompt_12\",\n                        \"text\": \"“你告诉她，肌肉会衰老，金钱会散去，权势会反咬一口，智慧也容易平添烦恼，实际上，他们都只是卑微的仆从，都为人生的幸福服务。”\\n“幸福？哦，或许你是对的，我爸爸给我买首饰的时候只关注哪一件银饰更精美、哪一颗珠宝能换更多的矿山与赌坊，他从未想过穿在我身上会不会舒服，唔……”\\n她似乎陷入了思考，那小小的、稚气的头颅里难得地装满了和珠宝首饰、华贵衣料无关的事，好吧，或许也并非完全无关。\\n“可是，就像您说的那样，没有力量、金钱、权势和智慧的支撑，幸福也只是空中楼阁。”她边说着，边可劲思考，孩子气的面庞难得地认真，“或许，我应该找一个权臣？嗯……他还得聪明睿智、身强体壮又富可敌国……哦，他当然还要英俊潇洒，可话说回来，当一个人有权势、有财富的时候，他看起来就是要比别人要英俊，比如说您，对吧？”\\n这本该是一个意图让你不知所措的玩笑，可话说出口，她的脸上又泛起一阵绯红。而你只是和她眨巴眨巴了眼，又一次欣赏起她手足无措的模样。\\n“哎呀，您只会欺负我！哪里谈得上幸福……”阿鲁米娜的说话声越说越小，最后一跺脚，逃也似地走了。\\n你看着她远去的背影哈哈大笑，至少这次她不至于又把面纱落下了。\",\n                        \"icon\":\"cards/2000774\"\n                    }\n                },\n                \"success\": {\n                    \"event_off\": 9321052\n                }\n            },\n            \"case:op2\": {\n                \"rite\":5008047, //少女的欢宴\n                \"option\": {\n                    \"id\":\"9321052_option_3\",\n                    \"text\": \"她的问题很简单，“到底什么样的男人才值得嫁？”\\n在她列举的新郎备选中，你惊恐地发现，竟然连苏丹都在列……其他人选包括了首都里所有优质男青年，她理所应当地觉得这其中每个人自己都有希望，只看自己喜不喜欢。\\n你一边思考着她到底是如何被父亲娇宠到这个地步的，一边谨慎地提出了你的看法……\",\n                    \"icon\":\"cards/2000774\",\n                    \"items\": [\n                        {\n                            \"text\": \"勇武\",\n                            \"tag\": \"op8\"\n                        },\n                        {\n                            \"text\": \"智慧\",\n                            \"tag\": \"op9\"\n                        },\n                        {\n                            \"text\": \"权力\",\n                            \"tag\": \"op10\"\n                        },\n                        {\n                            \"text\": \"财力\",\n                            \"tag\": \"op11\"\n                        }\n                    ]\n                },\n                \"case:op8\": {\n                    \"prompt\": {\n                        \"id\":\"9321052_prompt_6\",\n                        \"text\": \"“强壮的男人！我喜欢！超级喜欢！”她喘着粗气，猛烈表达赞同，“我尤其喜欢那些漂亮的腿……男人就要跑得快才对，这样决斗的时候也不会被抓住杀死！”\\n你很想纠正一下她对于“决斗”这件事的定义……但是，算了，反正她现在也听不进去。\\n“但勇武的男人要去哪里找呢？嗯……练武场？那里都是些油腻的富家公子……难道要我上战场？”\\n她歪着头，稚气的头颅里难得地充满了和华贵衣料、精美首饰无关的事。过了一会，她用力甩了甩头。\\n“不管了——总之这个给你，咨询的报酬！”\",\n                        \"icon\":\"cards/2000774\"\n                    }\n                },\n                \"case:op9\": {\n                    \"prompt\": {\n                        \"id\":\"9321052_prompt_7\",\n                        \"text\": \"你告诉她，肌肉会衰老，金钱会散去，权势会反咬一口，只有智慧永远伴随着你。\\n“但是，聪明的男人们总会用聪明的办法去骗他们的女人，是吧？我爸爸就是这样骗了我妈妈……唔，但妈妈也过得很舒服、很富裕，唔……”\\n她似乎陷入了思考，那小小的、稚气的头颅里难得地装满了和珠宝首饰、华贵衣料无关的事。\\n“找个聪明的男人好像是不错，前提是他还要有钱，还要帅，还要让我有地位——这种男人一旦出现，就会引起腥风血雨呢！”\\n说完，她就津津有味地给你讲了一堆首都年轻贵族女孩圈的八卦，这可都是浴场里听不来的猛料。\",\n                        \"icon\":\"cards/2000774\"\n                    }\n                },\n                \"case:op10\": {\n                    \"prompt\": {\n                        \"id\":\"9321052_prompt_8\",\n                        \"text\": \"“哦，就像您一样，对吗？父亲说您不高兴的时候，苏丹就也不高兴，而您永远知道怎么让苏丹高兴！”\\n她边说着，边认真思考，孩子气的面庞难得的严肃。\\n“所以我应该找一个权臣，嗯……而且要一个强壮的、聪明的、英俊的……当一个人有权势的时候，他看起来就是比别人要英俊，比如说您，对吧？”\\n你告诉她这话你确实不知道怎么接。\\n她大笑起来，似乎觉得这个玩笑很有趣。在她离开时，还在笑着说关于你多么英俊和多么有权势的事，这让你变得更有名了。\",\n                        \"icon\":\"cards/2000774\"\n                    }\n                },\n                \"case:op11\": {\n                    \"prompt\": {\n                        \"id\":\"9321052_prompt_9\",\n                        \"text\": \"“这样的话，我应该嫁给我爸才对，他是我见过的最会搞钱的人，无论是什么手段。”\\n她望着你的表情，然后突然哈哈大笑起来。\\n“我开玩笑的——看你……看您的脸，您不会当真了吧！我才不嫁给父亲呢，他太胖了！”\\n而后，她像是在思考你的话，孩子气的面容上难得露出了几许严肃。\\n“会赚钱的男人是最好的男人，您说的或许没错；只要他会赚钱，那么无论是勇士、是谋士、还是大臣，都可以花钱买到……”\\n她跳起身，冲你行了个礼，又塞给你一件东西。\\n“这是咨询的报酬。”\",\n                        \"icon\":\"cards/2000774\"\n                    }\n                },\n                \"success\": {\n                    \"event_off\": 5321052\n                }\n            }\n            }\n        }\n\n]\n}";