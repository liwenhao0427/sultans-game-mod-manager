module.exports = "{\n    \"id\": 9321054,\n    \"text\": \"银铃作哑\",     \n    \"is_replay\": 0, //是否可以重复触发\n    \"auto_start\": false,\n    \"start_trigger\": true, // 是否启动就立即开始校验条件\n    \"on\":{   //时机\n        \"round_begin_ba\": 1\n    },\n    \"condition\":{  //条件\n        \"have.2000057\": 1, //哲瓦德还活着\n        \"have.2000774\": 1, //阿鲁米娜还活着\n    },\n    \"settlement\": [    //效果 \n        {\n            \"tips_resource\":\"\", \n            \"tips_text\":\"\",\n            \"action\":{\n\t\t\t\t\"card\":[2000781,\"已拥有+1\"],\n\t\t\t\t\"card\":2000171,\n\t\t\t\t\"rite\": 9008049,    //开启一语成谶\n                \"prompt\":{\n                \"id\":\"9321054_prompt_01\",\n                \"text\":\"子夜，暴雨无情地冲刷着权臣府邸的青铜门环，声响像极了银铃将碎未碎的呜咽。\\n“你来了。”你叹了口气。\\n“我来了。”声音略带嘶哑。\\n“你本不该来的。”你又叹了口气。\\n“我毕竟已是来了。”声音中多了几分绝决。\\n你们都深知苏丹是个怎样的人……？至少深知他是个怎样的君王。\\n你望向这个一辈子唯利是图、利欲熏心的铁公鸡，好像这辈子第一次认识他。\\n“三座银矿，黑街四成的赌坊，再加上二十船与西域诸国往来的丝绸香料……”老人颤颤巍巍地抖开早已湿透的羊皮纸，墨迹在雨中晕染成蜿蜒的血河，“这是我六十年来攒下的腐臭膏脂——今夜之后，它们会像烂肉般被秃鹫分食了。”\\n你还是沉默不语，想要买通死神，这还远远不够。\\n毕竟你们都深知苏丹是个怎样的人……？至少深知他是个怎样的君王。\\n银铃又一次紧攥在哲瓦德渗血的手中，有的事物必须舍弃方能留存。\\n“所有。”哲瓦德他突然挺直腰背，多年来被谄媚压弯的脊椎发出朽木断裂般的声响，却奇迹般一节节绷成青铜剑的弧度，“无论你想要什么都好，只要我这具吸饱民脂民膏的腐尸，能够成为她踏出黄金鸟笼的血阶。”\\n老人往昔佝偻的身影如今宛若天神般高大，可你知道，在这个无情的雨夜，在门前伫立的无非只是一位父亲。\\n于是，无数间屋门被敲响、无数张唇舌在舞动、无数枚金币叮当作响——一场更猛烈的风暴在这个雨夜酝酿。\",\n                \"icon\":\"cards/2000057\"\n\t\t\t\t},\n\t\t\t\t//\"delay\": {  //延迟1回合执行\n                    //\"id\":93210549,\n                    //\"round\": 1,\n                    //\"rite\":9008049,    //开启一语成谶\n                //},\n\t\t\t\t\"success\":{\n                \"event_off\":9321054 //关闭\n\t\t\t\t}\n\t\t\t\t\n            }\n\t\t\t\n        }\n\t\t\n    ]\n}";